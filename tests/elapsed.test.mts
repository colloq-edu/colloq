/**
 * Два формата длительности, и третьего не будет.
 *
 * Живая цифра держит колонку и обновляется пять раз в секунду: десятая доля
 * секунды и ведущий ноль. Законченная читается один раз в предложении: без
 * десятых и без ведущих нулей. Разница намеренная, и без теста она исчезнет
 * при первой же попытке «привести к одному виду».
 */
import './_env.mts'
import { test } from 'node:test'
import assert from 'node:assert/strict'
import { elapsed, NOTICED_MS, spell } from '../web/src/lib/utils.js'

test('живая длительность растёт по разрядам', () => {
  const at = (ms: number) => elapsed(0, ms)
  assert.equal(at(0), '0.0s')
  assert.equal(at(12_340), '12.3s')
  assert.equal(at(59_900), '59.9s')
  assert.equal(at(60_000), '1m 00s')
  assert.equal(at(64_000), '1m 04s')
  assert.equal(at(3_599_000), '59m 59s')
  // Часовой разряд: без него ячейка, которая учит модель, печатала «143m 07s».
  assert.equal(at(3_600_000), '1h 00m')
  assert.equal(at(8_580_000), '2h 23m')
})

test('отставшие часы браузера дают ноль, а не отрицательное число', () => {
  // startedAt — серверное время; у того, чьи часы отстают, оно в будущем.
  assert.equal(elapsed(1_000_000, 999_000), '0.0s')
  assert.doesNotMatch(elapsed(1_000_000, 999_000), /-|NaN/)
})

test('законченная длительность — без десятых и без ведущих нулей', () => {
  assert.equal(spell(null), '')
  assert.equal(spell(4_400), '4s')
  // Не «1m 04s»: это и есть отличие от живой цифры.
  assert.equal(spell(64_000), '1m 4s')
  assert.equal(spell(80_000), '1m 20s')
  assert.equal(spell(3_600_000), '1h 0m')
  assert.equal(spell(8_580_000), '2h 23m')
})

test('порог заметности — две секунды', () => {
  // Ячейка, отработавшая триста миллисекунд, не должна обзаводиться цифрой:
  // к концу пары таких сорок, и все они сообщают, что компьютер быстрый.
  assert.equal(NOTICED_MS, 2_000)
})
