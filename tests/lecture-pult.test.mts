/**
 * Правила пульта лекции: палитра, часы, счёт листов, потолки чернил.
 *
 * Всё, что здесь проверяется, ломается МОЛЧА и посреди пары, и почти всё
 * когда-то было написано дважды. Секундомер и палитра стояли двумя копиями в
 * двух файлах, и копии успели разойтись: пульт объяснял измеренными числами,
 * почему синего пера в наборе нет, — и держал синее умолчанием. Потолки знал
 * только сервер, и отказ на 601-м штрихе выглядел на планшете как потерянный
 * кадр: линия рисовалась, четыре секунды жила на досылках и пропадала, а у
 * зала её не было вовсе. Счёт чистых листов жил в памяти вкладки, и
 * перезагрузка пульта убирала исписанные листы из ленты страниц.
 *
 * Сервера здесь нет намеренно: это чистая арифметика браузера. Что сервер
 * отказывает ровно на тех же числах, проверяет lecture.test.mts — там, где
 * живёт его память.
 */
import { test } from 'node:test'
import assert from 'node:assert/strict'
import {
  MAX_INKED_PAGES,
  MAX_NOTE_CHARS,
  MAX_POINTS_PER_MESSAGE,
  MAX_POINTS_PER_STROKE,
  MAX_STROKES_PER_PAGE,
  inkFullSays,
} from '../shared/lecture.js'
import {
  boardsInked,
  INKS,
  inkRefusal,
  stopwatch,
} from '../web/src/components/lecture/pult.js'

/* ------------------------------------------------------------- палитра */

test('в палитре четыре пера, чёрное первое, синего нет', () => {
  assert.equal(INKS.length, 4)
  // Умолчание пульта и полосы ноутбука — INKS[0], и это обязано быть чёрное:
  // им пишут, когда ничего не выбирали.
  assert.equal(INKS[0].name, 'Перо, чёрное')
  /*
   * Синий #0f2d69 убран, и довод измерен: на проекторе с внутризальным
   * контрастом ~300:1 он и чёрный оба падают в нижние 8 % шкалы и с восьмого
   * ряда неразличимы, а на ночном корпусе пульта его диск даёт 1.5:1.
   */
  assert.ok(
    !INKS.some((choice) => choice.color.toLowerCase() === '#0f2d69'),
    'синее перо вернулось в набор',
  )
})

test('имена перьев — договор с проверкой интерфейса', () => {
  // Ровно эти строки ищут ui-check и pencil-check по aria-label.
  const names = INKS.map((choice) => choice.name)
  for (const named of ['Перо, чёрное', 'Перо, красное', 'Перо, зелёное']) {
    assert.ok(names.includes(named), `имя «${named}» пропало из палитры`)
  }
  // Полоса ноутбука строит заголовок сама: «Перо, красный».
  assert.equal(INKS[1].short, 'красный')
})

/* ---------------------------------------------------------------- часы */

test('секундомер теряет секунды после часа, а до часа их держит', () => {
  assert.equal(stopwatch(0), '00:00')
  assert.equal(stopwatch(9_000), '00:09')
  assert.equal(stopwatch(75_000), '01:15')
  assert.equal(stopwatch(59 * 60_000 + 59_000), '59:59')
  // Через час вопрос звучит «сколько осталось», а не «сколько прошло».
  assert.equal(stopwatch(3_600_000), '1:00')
  assert.equal(stopwatch(3_600_000 + 2 * 60_000 + 15_000), '1:02')
  assert.equal(stopwatch(10 * 3_600_000), '10:00')
})

/* --------------------------------------------------------------- листы */

test('заведённые листы узнаются по чернилам, а не по памяти вкладки', () => {
  // Считается по НОМЕРАМ исписанных страниц: чернил одной страницы на руках у
  // вкладки может и не быть вовсе, а листы в ленте обязаны стоять все (см.
  // опись `ink:pages` и `inkedPages` в ink.ts).
  assert.equal(boardsInked([]), 0)
  // Слайды не листы: положительные страницы в счёт не идут вовсе.
  assert.equal(boardsInked([7]), 0)
  // Лист номер N доказывает, что заведены и все до него.
  assert.equal(boardsInked([-3, 4]), 3)
  assert.equal(boardsInked(new Set([-1, -2, -1])), 2)
})

/* -------------------------------------------------------------- потолки */

const strokes = (page: number, count: number, from = 0) =>
  Array.from({ length: count }, (_, i) => ({ id: `s${page}_${from + i}`, page }))

test('на неполной странице штрих открывается', () => {
  assert.equal(inkRefusal(strokes(1, 10), [], 1), null)
  // Чужие страницы к этой не относятся.
  assert.equal(inkRefusal(strokes(2, MAX_STROKES_PER_PAGE), [], 1), null)
})

test('на полной странице штрих не открывается и отказ говорит словами', () => {
  const why = inkRefusal(strokes(1, MAX_STROKES_PER_PAGE), [], 1)
  assert.equal(why, 'page-full')
  // Слова — из shared: своей копии фразы у пульта нет, и что она там одна на
  // оба конца, держит lecture-one-voice.
  assert.ok(inkFullSays('page-full').length > 0)
  assert.notEqual(inkFullSays('page-full'), inkFullSays('too-many-pages'))
})

test('свои неподтверждённые штрихи считаются один раз, а не дважды', () => {
  const known = strokes(1, MAX_STROKES_PER_PAGE - 1)
  /*
   * Мокрый штрих, у которого эхо уже вернулось, лежит и в чернилах комнаты, и
   * на мокром слое. Посчитанный дважды, он закрывал бы страницу на штрих
   * раньше срока — то есть отказывал бы там, где сервер принимает.
   */
  const echoed = [{ id: known[0].id, page: 1 }]
  assert.equal(inkRefusal(known, echoed, 1), null)
  // А не вернувшееся эхо — это настоящий штрих, и он добирает потолок.
  assert.equal(inkRefusal(known, [{ id: 'свежий', page: 1 }], 1), 'page-full')
})

/* -------------------------------------------------- потолок страниц */

test('исписанные страницы кончились: новая не заводится, старая пишется', () => {
  const many = Array.from({ length: MAX_INKED_PAGES }, (_, i) => ({ id: `p${i}`, page: i + 1 }))
  assert.equal(inkRefusal(many, [], MAX_INKED_PAGES + 1), 'too-many-pages')
  // Страница, которая уже исписана, к потолку страниц отношения не имеет.
  assert.equal(inkRefusal(many, [], 1), null)
})

/*
 * ПОТОЛКИ — ОДНИ НА ОБА КОНЦА, и держат их два теста, а не один.
 *
 * Здесь проверяются объявленные числа, в lecture.test.mts — что сервер
 * отказывает ровно на них. Разъехаться копии не могут молча: сдвинется
 * серверная — упадёт тот тест, сдвинется объявленная — этот. А цена разъезда
 * ровно та, ради которой числа и переехали в shared: линия, которую ведущий
 * нарисовал, четыре секунды видел на своём листе и не увидел у зала.
 */
test('объявленные потолки — те же, на которых отказывает сервер', () => {
  assert.equal(MAX_STROKES_PER_PAGE, 600)
  assert.equal(MAX_POINTS_PER_STROKE, 4_000)
  assert.equal(MAX_POINTS_PER_MESSAGE, 512)
  assert.equal(MAX_INKED_PAGES, 200)
  assert.equal(MAX_NOTE_CHARS, 3000)
})
