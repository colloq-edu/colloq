# Copy to .env and adjust. `docker compose up` reads it automatically.

# PORT is the port on THIS machine; PUBLIC_URL is what goes into the link a
# student receives. Change them together — nothing derives one from the other,
# and a mismatch produces links that point at a port nobody is listening on.
PORT=3000
PUBLIC_URL=http://localhost:3000

# Часовой пояс инстанса — один на всё: журнал сервера, `datetime.now()` в
# ячейке студента и даты на выложенных страницах («2 сентября, 18:30»).
# Страницы и без этой строки считают по Москве, а контейнер — по UTC, и тогда
# «когда это упало» в журнале и на сайте расходятся на три часа. Инстанс не в
# Москве меняет одну эту строку.
TZ=Europe/Moscow

# --- Как семинар выходит наружу ---------------------------------------
# Транспортов четыре, и у каждого своя цена. Коротко: своя машина с белым
# адресом — прямой режим; ноутбук или арендованная машина — туннель.
#
#   make host                        быстрый туннель Cloudflare. Ничего не
#                                    настраивать, адрес случайный и живёт до
#                                    Ctrl+C. Цена: из России не открывается.
#
#   make host HOST=имя.example.ru    именованный туннель Cloudflare (сначала
#                                    один раз make tunnel-setup). Адрес
#                                    постоянный. Цена та же: не для России.
#
#   make host HOST=hse.colloq.ru     свой ретранслятор: инстанс дозванивается
#                                    до него исходящим frpc. Работает откуда
#                                    угодно — из-за NAT, с ноутбука, с
#                                    арендованной машины. Цена: ретранслятор
#                                    один на все имена под ним, и он общая
#                                    точка отказа. ИЗМЕРЕНО на живой паре:
#                                    VPS на 951 МБ памяти двести сокетов не
#                                    держит — ядро 36 раз за вечер убивало то
#                                    frps (209 МБ), то caddy (186 МБ), и
#                                    каждое убийство рвало все туннели разом.
#                                    Для настоящей аудитории ретранслятору
#                                    нужно 2–4 ГБ — или берите прямой режим.
#
#   make host-direct HOST=hse.colloq.ru
#                                    прямо с этой машины: здесь же поднимается
#                                    caddy, имя A-записью направляется на этот
#                                    адрес, сертификат берётся сам. Посредника
#                                    на пути студентов нет вовсе, и падать
#                                    между ними и машиной нечему. Цена: нужны
#                                    настоящий публичный адрес и настоящие 80
#                                    и 443 (на vast.ai их не дают — там только
#                                    туннель), root и запись в зоне через
#                                    Cloudflare API (CF_TOKEN ниже). Адрес
#                                    держит служба caddy, а не открытое окно.
#
# Ретранслятор ставится один раз и печатает готовые строки — четыре ниже. Пока
# RELAY_DOMAIN пуст, ретранслятор не используется вовсе и туннель идёт в
# Cloudflare:
#
#   make relay-setup WHERE=root@<адрес>    поставит на VPS caddy и frps
#
# RELAY_DOMAIN=colloq.ru
# RELAY_ADDR=203.0.113.11
# RELAY_PORT=7000
# RELAY_TOKEN=

# --- Ключ к зоне DNS (нужен прямому режиму) ---------------------------
# Им scripts/dns.sh пишет записи: `make host-direct` направляет имя семинара
# на адрес этой машины, а прогон без аргументов приводит в порядок всю зону
# (лендинг, www, *.colloq.ru на ретранслятор).
#
# Токен заводится на https://dash.cloudflare.com/profile/api-tokens с правами
# Zone:Read и DNS:Edit на нужную зону. CF_ZONE — идентификатор зоны со
# страницы её обзора; он не обязателен, но с ним запись ставится и токеном,
# которому не разрешено листать список зон.
#
# Записи всегда создаются БЕЗ проксирования (серое облако). Оранжевое увело бы
# студентов на пограничные адреса Cloudflare, а они из России не открываются.
# CF_TOKEN=
# CF_ZONE=

# --- Машина напрокат (необязательно) ----------------------------------
# Своей машины с GPU может не быть вовсе — тогда её берут почасово на vast.ai:
#
#   make vast-up      арендовать виртуалку и развернуть на ней Colloq
#   make vast-status  что арендовано, живо ли оно и сколько натикало
#   make vast-sync    снять данные оттуда сюда
#   make vast-down    уничтожить машину — данные на ней исчезнут вместе с ней
#   make vast-adopt   назвать средой машину, арендованную ещё без имени
#
# Занятие целиком одной командой:
#
#   make vast-up GPU="RTX 5070" HOST=demo.colloq.ru
#
# HOST — адрес, на котором семинар откроется у аудитории. Требует RELAY_* ниже:
# наружу арендованная машина выходит только через ретранслятор. Имя без точки
# считается поддоменом RELAY_DOMAIN («demo» → demo.colloq.ru). Туннель там
# держит tmux-сессия «colloq-host» — он переживает закрытый ноутбук, но не
# уничтожение машины. Без HOST адрес не поднимается вовсе, как раньше.
#
# GPU — карта на это занятие, сильнее строки VAST_GPU ниже.
#
# NAME — среда: hse и demo это две АРЕНДОВАННЫЕ МАШИНЫ, два счёта и две базы.
# Общего у сред только этот код и ретранслятор; вторая среда — это вторая цена
# за час, а не вторая комната на той же машине.
#
#   make vast-up NAME=demo HOST=demo.colloq.ru
#   make vast-sync NAME=demo   ·   make vast-down NAME=demo
#   make vast-status            без имени — список всех сред
#
# Имя среды — то же слово, что и первая часть адреса: назвав HOST, NAME можно
# не называть. Оно же метка инстанса на vast («colloq-demo») и подкаталог
# копий (backups/demo/) — копии одной среды никогда не разворачиваются в
# другую. Пока среда одна, имя можно не называть вовсе; как только их две,
# vast-sync и vast-down без имени отказывают со списком.
#
# Машина, арендованная до появления имён (метка «colloq»), считается безымянной
# средой и не теряется. Назвать её, не пересоздавая: make vast-adopt NAME=demo.
#
# Ключ заводится на https://cloud.vast.ai/manage-keys/ и показывается ровно один
# раз. Им снимают деньги, поэтому скрипт его не печатает, не передаёт аргументом
# командной строки (её видно через `ps`) и не увозит на арендованную машину.
# VAST_TOKEN=
#
# Остальное — умолчания, трогать не обязательно:
#
# VAST_LABEL=colloq          метка на инстансе; по ней он потом и находится.
#                            К ней приписывается имя среды: colloq-demo
# VAST_SSH_KEY=~/.ssh/id_ed25519
#                            ключ ДОЛЖЕН быть заранее в аккаунте vast:
#                            виртуалке ключи после запуска не добавляют, и
#                            машина без ключа — деньги за коробку, в которую
#                            нельзя войти
# VAST_GPU=                  «RTX 4090» — с пробелом, как в API; пусто — любая.
#                            На одно занятие: make vast-up GPU="RTX 5070"
# VAST_GPU_RAM=24            память карты, ГБ. Умолчание достаётся только тем,
#                            кто карту не назвал: у названной карты память уже
#                            выбрана, и 24 превратили бы «хочу 5070» (12 ГБ) в
#                            «предложений нет». Строка здесь действует всегда —
#                            вписав её, вы отсекаете и 5070
# VAST_MAX_PRICE=1.0         потолок $/час; берётся самое дешёвое из подходящих
# VAST_DISK=60               диск, ГБ: образ ядра с torch — это десятки
# VAST_IMAGE=docker.io/vastai/kvm:ubuntu_cli_22.04-2025-11-21
#
# Арендуются только виртуалки и только on-demand: в обычном docker-инстансе vast
# запрещает docker внутри, а значит у комнаты не будет своего ядра;
# interruptible же вытесняют посреди пары. Подробно — в шапке scripts/vast.sh.

# Signs participant tokens, host tokens and the staff cookie.
# Leave it empty: the server makes one on first boot and keeps it in DATA_DIR,
# which is what stops a restart from signing the whole room out mid-seminar.
# Set it only to rotate the key, or to share one across several replicas.
SESSION_SECRET=

# Shared secret between the app and the Jupyter container. Never sent to browsers.
JUPYTER_TOKEN=colloq-dev-token

# --- AI ---------------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, vLLM, Ollama, LM Studio, OpenRouter...
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Examples:
#   Ollama      OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#               OPENAI_MODEL=llama3.1  OPENAI_API_KEY=ollama
#   vLLM        OPENAI_BASE_URL=http://host.docker.internal:8000/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Kernel limits ----------------------------------------------------
# Потолок на КОМНАТУ, когда у семинара свой контейнер, иначе — на общее ядро.
# Не резерв — docker не занимает эту память заранее, — а предел, за который
# разогнавшаяся ячейка не выйдет.
KERNEL_MEM=2g
KERNEL_CPUS=2

# Устройства GPU, которые сервер может отдать комнатам, — списком через запятую
# ровно в том виде, в каком их понимает docker: `MIG-GPU-…`, или `0`, или `0,1`.
# Пусто или нет строки вовсе — сегодняшнее поведение: GPU не просит никто.
#
# Срез достаётся КОМНАТЕ на всё время жизни её контейнера и записывается на нём
# меткой `colloq.gpu=<устройство>`. Метка — источник правды: она переживает
# перезапуск сервера, а карта в памяти нет; свободен тот срез, которого нет ни
# на одном контейнере комнаты (включая остановленные — их ещё поднимут).
#
# GPU — свойство ОКРУЖЕНИЯ, а не комнаты: его просит окружение, объявившее это
# строкой `# colloq: gpu` в шапке kernel/environments/<имя>.txt. Комната на
# обычном окружении срез не занимает никогда. Срезов не хватило — ядро честно
# не поднимется: колёса torch собраны под CUDA, на процессоре такая комната не
# поедет, и притворяться нельзя.
#
# На арендованной машине эту строку дописывает scripts/vast.sh — номерами карт,
# которые там нашлись.
# KERNEL_GPUS=

# /dev/shm у комнаты с GPU. Умолчание docker — 64 МБ, и на них DataLoader с
# несколькими воркерами падает на ровном месте. Комнат без GPU не касается.
KERNEL_SHM=1g

# Свой контейнер на семинар. `off` возвращает прежнее устройство — одно ядро
# на всех, — вместе с прежним свойством: из любой комнаты видны файлы всех
# остальных на этой машине. Выключать только зная это.
#
# Работает во всех трёх способах запуска: при `make run` и под службой systemd
# (`make service-install` — сервер на хосте) docker виден напрямую, при `make
# up` серверу смонтирован сокет. Нет сокета, нет прав на него или нет сети из
# KERNEL_NETWORK — комнаты делят одно ядро compose, и сервер говорит об этом в
# журнал и в саму комнату, а не молчит.
#
# Под службой это «одно ядро» взять неоткуда: ядро compose там никто не
# поднимает. То есть KERNEL_ISOLATION=off на выделенной машине означает не
# «общий Python», а «никакого» — если только вы не подняли ядро сами
# (`make dev` публикует 8888 на петлю).
KERNEL_ISOLATION=auto

# Три строки ниже нужны ТОЛЬКО серверу, который сам живёт в контейнере (`make
# up`), и compose подставляет их сам — руками задавать нечего, кроме особых
# случаев.
#
# DOCKER_GID — группа /var/run/docker.sock глазами демона; без неё сервер от
#   пользователя `node` сокет не откроет. `make up` определяет её и дописывает
#   сюда сам. Узнать вручную: stat -c %g /var/run/docker.sock
# WORKSPACE_HOST_DIR — где ./workspace лежит на ХОСТЕ. Пути `-v` разбирает
#   демон, для него /workspace внутри контейнера ничего не значит.
# KERNEL_NETWORK — сеть compose, в которой сервер зовёт ядро комнаты по имени
#   контейнера. Умолчание — `colloq`, как сеть названа в docker-compose.yml.
#
# И ровно поэтому при сервере НА ХОСТЕ (make run, служба systemd)
# WORKSPACE_HOST_DIR обязан быть пуст. Он не просто лишний: сервер читает его
# как признак «я в контейнере» и тогда ставит ядро комнаты в сеть compose,
# обращаясь к нему по имени контейнера, — а с хоста такого адреса нет, и каждый
# Run кончается ошибкой. Пустой — ядро комнаты публикует порт на 127.0.0.1, и
# это верный адрес. `make service-install` проверяет это и отказывается ставить
# службу поверх такой строки.
# DOCKER_GID=
# WORKSPACE_HOST_DIR=
# KERNEL_NETWORK=colloq
MAX_UPLOAD_MB=50
# Всё, что держит один семинар. Ограничение было только на файл: пятьдесят
# мегабайт за раз и сто заходов дают пять гигабайт, а диск здесь общий с базой,
# снимками тетрадей и образами окружений.
MAX_SESSION_MB=1024

# Просить ли у модели её рассуждение отдельным полем. Выключено: у рассуждающих
# моделей след стоит как ответ, а иногда дороже, и просить его на каждый вопрос
# — включая «объясни эту ошибку» — значит тихо удваивать счёт. Когда провайдер
# отдаёт след сам, он виден и без этого.
AI_REASONING=false

# --- Teaching side ----------------------------------------------------
# Who deployed this instance: the line next to the logo, on every screen that
# draws it — the room, the projection, the pult and the join poster. A
# university on one address, a bank on another. Empty — the default — means
# there is no line at all: no rule, no caps, just the mark. Longer than 80
# characters is cut: it stands on one line beside the logo and would otherwise
# leave the seminar's own name with nothing.
INSTITUTION=

# Prefills the owner's address on the first-run claim screen. Identity only:
# Colloq never sends mail. The setup token printed on first boot (and kept in
# <DATA_DIR>/setup-token) is what actually proves ownership.
ADMIN_EMAIL=you@your-university.edu

# Let anyone with the URL create a seminar from the home screen. Off by
# default: with a staff list in place, an open instance lets any visitor spin
# up a room and spend your API key.
OPEN_SEMINAR_CREATION=false

# Окружение Python по умолчанию: с ним создаются новые семинары, и оно же
# запекается в образ общего ядра. Списки пакетов лежат в
# kernel/environments/<имя>.txt и ставятся поверх базы из kernel/requirements.txt.
# У уже созданного семинара окружение своё, выбранное при создании, и эта
# строка его не меняет. Менять руками не нужно: `make env-use NAME=cv`
# переписывает её сам, потому что compose читает переменную отсюда, а не из
# командной строки.
KERNEL_ENV=base
