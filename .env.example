# Copy to .env and adjust. `docker compose up` reads it automatically.

# Public origin students will open. Used to build the shareable link.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Signs participant tokens. Change it; any random string works.
SESSION_SECRET=please-change-this

# Shared secret between the app and the Jupyter container. Never sent to browsers.
JUPYTER_TOKEN=colloq-dev-token

# --- AI ---------------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, vLLM, Ollama, LM Studio, OpenRouter...
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Examples:
#   Ollama      OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#               OPENAI_MODEL=llama3.1  OPENAI_API_KEY=ollama
#   vLLM        OPENAI_BASE_URL=http://host.docker.internal:8000/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Kernel limits ----------------------------------------------------
KERNEL_MEM=2g
KERNEL_CPUS=2
MAX_UPLOAD_MB=50

# --- Teaching side ----------------------------------------------------
# Prefills the owner's address on the first-run claim screen. Identity only:
# Colloq never sends mail. The setup token printed on first boot (and kept in
# <DATA_DIR>/setup-token) is what actually proves ownership.
ADMIN_EMAIL=sleep3r@icloud.com

# Let anyone with the URL create a seminar from the home screen. Off by
# default: with a staff list in place, an open instance lets any visitor spin
# up a room and spend your API key.
OPEN_SEMINAR_CREATION=false
