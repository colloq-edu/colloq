{
  "name": "@colloq/web",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "build:optimized": "npm run build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "assets": "npm run pdf:worker && npm run plotly:dist",
    "pdf:worker": "node -e \"const{copyFileSync,mkdirSync}=require('fs');mkdirSync('public/pdf',{recursive:true});copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'),'public/pdf/pdf.worker.min.mjs')\"",
    "plotly:dist": "node -e \"const{copyFileSync,mkdirSync}=require('fs');mkdirSync('public/plotly',{recursive:true});copyFileSync(require.resolve('plotly.js-strict-dist-min/plotly-strict.min.js'),'public/plotly/plotly.min.js')\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.1",
    "ansi_up": "^6.0.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.3",
    "katex": "^0.18.7",
    "marked": "^15.0.4",
    "pdfjs-dist": "^6.2.108",
    "plotly.js-strict-dist-min": "^4.1.1",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tsconfig/svelte": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
