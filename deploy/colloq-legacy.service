# Colloq на выделенной машине: сервер здесь, на хосте, а в docker — только ядра
# комнат. Ставит этот файл scripts/service.sh install; руками его класть не надо.
#
# ПОЧЕМУ ФАЙЛОМ, А НЕ ГЕНЕРАЦИЕЙ В СКРИПТЕ. Юнит, собранный heredoc'ом внутри
# bash, нельзя ни прочитать глазами в репозитории, ни проверить
# `systemd-analyze verify` — а ошибка в нём стоит семинара. Здесь он лежит
# целиком, и единственное, чего в нём нет, — настоящий путь репозитория:
# установка подставляет его простой заменой каталога, записанного ниже в
# WorkingDirectory. Умолчание выбрано так, чтобы файл был валиден и без всякой
# подстановки, — это тот каталог, в который кладёт репозиторий scripts/vast.sh.
#
# ПОЧЕМУ ОТ ROOT — это цена решения, а не недосмотр.
#
#   1. Серверу нужен /var/run/docker.sock: им он поднимает каждой комнате её
#      собственное ядро. Доступ к этому сокету и есть root на машине — кто
#      может `docker run -v /:/host`, тот может всё. Работать «от обычного
#      пользователя, но в группе docker» — та же власть, только названная
#      вежливее.
#   2. Файлы семинаров пишет контейнер ядра, а он работает от uid 1000
#      (`runner` в kernel/Dockerfile). Сервер пишет туда же — загрузки, снимки
#      тетрадей. Из всех пользователей машины только root читает и правит и
#      своё, и чужое без единого chown.
#
# Чего этим куплено: сервер, упавший в чужой код, падает с правами root. Поэтому
# наружу инстанс выходит исходящим соединением (см. scripts/host.sh), ни один
# входящий порт не открыт, а машина под семинары — выделенная.
#
# Обратная сторона той же пары — UMask ниже; без него семинар молча ломается.

[Unit]
Description=Colloq — семинары на этой машине
Documentation=https://github.com/colloq-edu/colloq
# Ядро комнаты поднимает сам сервер, docker'ом, — значит демон должен быть
# раньше нас. Wants, а не Requires, и это разница в цене: Requires уносит
# службу вместе с docker при каждом его перезапуске (а его перезапускает,
# например, установка nvidia-container-toolkit), то есть посреди пары. Нет
# docker — сервер скажет об этом в журнал и в комнату, и это честнее, чем
# инстанс, исчезнувший без объяснений.
Wants=network-online.target docker.service
After=network-online.target docker.service
# ПОДНИМАТЬ ВСЕГДА, А НЕ ПЯТЬ РАЗ.
#
# `Restart=always` ниже обещает «упал — поднять», но у systemd поверх него
# стоит свой предел: пять запусков за десять секунд (StartLimitBurst=5,
# StartLimitIntervalSec=10s), и шестой не делается вовсе — юнит уходит в
# failed и ждёт `systemctl reset-failed` руками. При RestartSec=2 это ровно
# тот случай, ради которого Restart и написан: сервер падает на старте по
# повторяющейся причине — занятый порт, битая строка в базе, исключение на
# первом же кадре переподключающегося студента, — и вместо цикла перезапусков
# на паре остаётся мёртвый инстанс, о котором никто не узнает.
#
# Ноль здесь означает «предел не считать». Цена — цикл перезапусков, если
# сервер не может стартовать в принципе; но об этом видно в журнале, а
# вставшая насмерть служба посреди занятия не видна никак.
StartLimitIntervalSec=0

[Service]
# Type=exec, а не simple: systemd считает запуск удавшимся только после
# успешного exec, поэтому «нет node» и «нет server/dist/server.js» видно сразу
# в `systemctl start`, а не через минуту в журнале. Требует systemd 240+ —
# в Ubuntu 20.04 и Debian 10 он новее.
Type=exec
User=root
Group=root

WorkingDirectory=/opt/colloq
# Файл настроек читается ДВАЖДЫ, и обе дороги нужны.
#
# systemd раздаёт эти строки процессу окружением; сам сервер вдобавок читает
# .env из рабочего каталога (dotenv). Второе важнее, чем кажется: PUBLIC_URL и
# KERNEL_ENV сервер перечитывает из файла на ходу, поэтому `make host` и
# переключение окружения в панели не требуют перезапуска.
#
# Без «-» перед путём: нет .env — служба не стартует вовсе. Это намеренно.
# Стартовать без него значит поднять инстанс с умолчаниями — чужой токен
# Jupyter, localhost в ссылках для аудитории, — и узнать об этом на паре.
EnvironmentFile=/opt/colloq/.env
# development, а не production: с production сервер требует брокер ядер k3s
# и отказывает докер-бэкенду («for local development only»). Прежний путь —
# это ядра в докере на этой же машине, ровно как `make run` на ноутбуке.
Environment=NODE_ENV=development
# Слушать только петлю: наружу Colloq выходит исходящим туннелем (scripts/host.sh),
# а открытый порт на публичном адресе машины — вторая дверь в ту же комнату,
# которую никто не заводил. Под `make up` умолчание другое и остаётся прежним:
# там до сервера в контейнере иначе не достучаться.
Environment=BIND_ADDR=127.0.0.1
# Собранный клиент отдаёт сам сервер. В контейнере это делает Dockerfile, здесь
# сказать некому: без строки открывается голое API, а на месте комнаты — 404.
Environment=STATIC_DIR=/opt/colloq/web/dist
# Ядра комнат — контейнеры docker на этой же машине. Без этого сервер ждёт
# брокер k3s и отвечает «Каталог образов ядра не настроен» (13.09.2026).
Environment=KERNEL_BACKEND=docker

# `/usr/bin/env node`, а не прибитый путь: node приезжает то из nodesource
# (/usr/bin/node), то распакованным в /usr/local/bin. Оба каталога есть в PATH
# systemd по умолчанию, и env находит тот, который на машине стоит. Путь к
# самому серверу — абсолютный: он не должен зависеть ни от чего, кроме этой
# строки.
ExecStart=/usr/bin/env node /opt/colloq/server/dist/server.js

# УПАЛ — ПОДНЯТЬ. Пара идёт, студенты в комнате; необработанное исключение
# сервер честно доводит до выхода с ненулевым кодом (см. server/src/index.ts),
# и единственное разумное продолжение — встать заново. Снимки тетрадей при
# этом уже на диске, сокеты переподключаются сами.
Restart=always
RestartSec=2

# ОСТАНОВКА — ТОЛЬКО SIGTERM, И С ЗАПАСОМ ПО ВРЕМЕНИ.
#
# По SIGTERM (и SIGINT) сервер закрывает сокеты, сбрасывает снимки тетрадей и
# по-настоящему закрывает базу: sqlite в режиме WAL сводит журнал только при
# закрытии, иначе на диске остаётся вчерашняя база и день работы рядом, в
# colloq.db-wal. Свой предел у него восемь секунд (SHUTDOWN_GRACE_MS), поэтому
# здесь двадцать: systemd не должен добить SIGKILL то, что ещё пишет.
KillSignal=SIGTERM
TimeoutStopSec=20

# UMASK 0002 — ЭТО НЕ УКРАШЕНИЕ, БЕЗ НЕГО КОМНАТА НЕ МОЖЕТ ПИСАТЬ.
#
# Папку комнаты (workspace/<id>) заводит сервер, то есть root, а пишет в неё
# ядро комнаты — контейнер от uid 1000. С обычным umask 0022 папка выходит
# root:root 0755, и первый же `open('out.csv','w')` в ячейке падает
# PermissionError, хотя на экране всё зелено. При 0002 она выходит 0775, а
# группу и бит setgid наследует от workspace/, которому установка ставит
# группу 1000, — и обе стороны пишут в одни и те же байты.
#
# Ровно то же самое, что раньше получалось само собой: и в контейнере (`make
# up`), и при `make run` сервер работал от uid 1000, того же, что и ядро.
# Здесь он root, и совпадение надо создать руками.
#
# 0002, а не 0000: файлы становятся доступны на запись группе, а не всей
# машине. База при этом остаётся root:root, а ключ подписи и токен установки
# сервер создаёт с явными 0600 — umask их не ослабляет.
UMask=0002

# Сокетов на семинар — по несколько на человека (комната, проекция, пульт), и
# ещё столько же держит связь с ядрами. Умолчание systemd в 1024 упирается
# ровно там, где аудитория большая.
LimitNOFILE=65535

# Журнал — в journald, смотреть его: make service-logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=colloq

[Install]
WantedBy=multi-user.target
