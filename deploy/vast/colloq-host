#!/usr/bin/env bash
#
# colloq-host: Colloq on a machine with Docker. Bring it up, update it, back it up.
#
#   colloq-host doctor               is this machine ready (before the first up, without the container)
#   colloq-host up                   install what is missing, pull the image, start
#   colloq-host update [IMAGE]       switch to another image, backup first; data and room kernels stay
#   colloq-host status               is the instance ready for a class
#   colloq-host link                 the class address and the owner's link
#   colloq-host logs                 the Colloq log (Ctrl+C to leave)
#   colloq-host backup               a backup into <state>/backups/
#   colloq-host backup-timer on|off|status    the same every night, by a systemd timer
#   colloq-host restore [--image IMAGE] [FILES]   stop, restore a backup, start again
#   colloq-host stop | start         stop / start Colloq (room kernels keep running)
#   colloq-host bundle FILE [IMAGE]  on a connected machine: everything an offline server needs, in one file
#   colloq-host load FILE            on the offline server: load that file; up then needs no network
#
#   colloq-host runner up URL CODE [IMAGE] [--classes]   this machine runs another instance's submissions
#                                    (--classes: and its classes; checked first that it can)
#   colloq-host runner update [VERSION|IMAGE] [--now]   to the home's version, its runs finished first
#   colloq-host runner status | logs | leave [--force]  joined and syncing? / its log / revoke itself and go
#   colloq-host runner-code [--machines N] [--hours H] [--trusted | --classes] [--slots S]   on an instance:
#                                    a code for such machines, printed inside the commands that join them
#
# The image puts it on the machine (`colloq-vast install-host`). On a Vast VM
# the template's on-start (deploy/vast/onstart.sh) calls it; on a server of
# your own a person does (docs/pages/en/server.html). Runs as root, apart from
# doctor and bundle.
#
# WHY IT EXISTS WHEN EVERYTHING IS IN THE IMAGE. Somebody has to say
# `docker run` once, with the Docker socket and the state directory, and say it
# again after every update. On a Vast VM the template's image can only be
# docker.io/vastai/kvm:* (an image of your own runs only as an ordinary Docker
# instance, with no Docker inside and so no container per room; see
# deploy/vast/README.md, "Design"), and a university's own server has the same
# need without the rental. This file is that `docker run`, plus what the ssh
# script scripts/vast-legacy.sh used to do: nvidia-container-toolkit, the list
# of cards, backups. Nothing is built on the machine: the image arrives ready.
#
# Settings live in /etc/colloq/colloq.env (0600): `up` writes them from the
# environment it is called with (the on-start, or a person), and `update` reads
# them again. A variable that is missing or empty in the call does not erase its
# line in the file.
#
# The image lives in /etc/colloq/image, and there the rule is the reverse:
# COLLOQ_IMAGE from the on-start only creates the file, and from then on
# `update` and `load` own it. See image() below.
#
# A MACHINE FOR SUBMISSIONS («машина для посылок») is the same image in another
# mode, `runner`: no server, no tunnel, no database, only the agent that runs
# another instance's notebook steps (docs/architecture/remote-runners.md). It
# keeps apart from the instance in every file: its container colloq-runner,
# its settings /etc/colloq/runner.env, its image /etc/colloq/runner-image, and
# its tree /var/lib/colloq-runner, mounted at the same path on both sides.
# That is so that neither can rewrite the other's settings, not so that one
# server can be both. Such a machine is given over to its home whole: the
# agent shares out every card it finds and admits submissions by the whole
# machine's memory, knowing nothing of a class's rooms on the same Docker, and
# it holds the Docker socket, which is root there. Like a home, a machine for
# submissions needs a machine of its own (§6 of the design), and `runner up`
# says so when it finds an instance next to it: a university lends a server
# it can spare for the competition, not the one its class runs on.
#
# A MACHINE THAT TAKES CLASSES («Принимает занятия», a flag of the code it
# joins with; docs/architecture/remote-classes.md) is the same agent holding
# its home's class kernels too: a container per class beside the
# submissions, reached through one tunnel the agent dials home. The agent's
# container runs on the host's network (--network host, every machine's from
# 0.25 on), so that it reaches each kernel's Jupyter on the host's 127.0.0.1,
# where nothing from outside does. `runner up --classes` checks first that
# the machine can host classes, `runner update` keeps them running (the new
# agent adopts their containers), and `runner leave` asks before it moves
# them off the machine.
#
# NOTHING ON THE HOST CHANGES UNASKED. Automatic updates are switched off and
# the NVIDIA packages held only under COLLOQ_FREEZE_UPDATES=1, which the Vast
# on-start sets (freeze_host_updates says why). A university's server keeps its
# own update policy: its administrators decide when the kernel and the driver
# move, and a script that quietly turned security updates off on a long-lived
# machine would be the worst kind of help.
set -euo pipefail

CONF_DIR="${COLLOQ_CONF_DIR:-/etc/colloq}"
ENV_FILE="$CONF_DIR/colloq.env"
IMAGE_FILE="$CONF_DIR/image"
# A machine for submissions: its own settings, image, container and record of
# the codes it has left with (runner_command switches ENV_FILE to its file).
RUNNER_ENV_FILE="$CONF_DIR/runner.env"
RUNNER_IMAGE_FILE="$CONF_DIR/runner-image"
RUNNER_LEFT_FILE="$CONF_DIR/runner.left"
RUNNER_NAME=colloq-runner
# Where the on-start and the docs put colloq-host, and where `load` installs the
# bundled one.
HOST_BIN=/usr/local/sbin
SYSTEMD_DIR="${COLLOQ_SYSTEMD_DIR:-/etc/systemd/system}"

say()  { printf '[colloq-host] %s\n' "$*"; }
warn() { printf '[colloq-host] WARNING: %s\n' "$*" >&2; }
die()  { printf '[colloq-host] ERROR: %s\n' "$*" >&2; exit 1; }

env_value() {
  grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true
}

# The call's own value, else the one `up` remembered, else the default. A
# setting given once to `up` must still hold for the `update` a month later:
# losing COLLOQ_HOME there would start the new version on an empty directory,
# and losing COLLOQ_BIND would cut off a university's proxy on another host.
setting() {
  local value="${!1:-}"
  [ -n "$value" ] || value="$(env_value "$1")"
  printf '%s' "${value:-${2:-}}"
}

STATE="$(setting COLLOQ_HOME /workspace/colloq)"
NAME="$(setting COLLOQ_CONTAINER_NAME colloq)"
NET="$(setting KERNEL_NETWORK colloq)"
LISTEN_PORT="$(setting PORT 3000)"

need_root() {
  [ "$(id -u)" = 0 ] || die "run as root: it manages docker, $CONF_DIR and $STATE"
}

# What travels from the environment into the container. A list, not everything:
# the on-start's environment also holds vast's variables, PATH and the like,
# which have no place in the server. The registry keys (COLLOQ_REGISTRY_*) are
# left out on purpose: the host's docker needs them, not the process that
# student code reaches through the kernel.
APP_KEYS="PUBLIC_URL COLLOQ_TUNNEL COLLOQ_HOSTNAME RELAY_DOMAIN RELAY_ADDR RELAY_PORT RELAY_TOKEN
CLOUDFLARE_TUNNEL_TOKEN OPENAI_API_KEY OPENAI_BASE_URL OPENAI_MODEL AI_PROVIDER AI_REASONING
ADMIN_EMAIL INSTITUTION UI_LANGUAGE TZ SESSION_SECRET OPEN_SEMINAR_CREATION MAX_UPLOAD_MB MAX_SESSION_MB COUNCIL_COPY_MB COUNCIL_MEMORY_GUARD
KERNEL_ENV KERNEL_PRELOAD KERNEL_IMAGE_REPO KERNEL_IMAGE_TAG KERNEL_MEM KERNEL_CPUS
KERNEL_GPUS KERNEL_SHM KERNEL_OWN_MAX KERNEL_OWN_PIDS KERNEL_OWN_IDLE_MIN KERNEL_ROOM_IDLE_MIN PUBLIC_IPADDR VAST_TCP_PORT_3000
COMPETITION_SLOTS COMPETITION_GPUS COMPETITION_GPU_PER_DEVICE
TRUSTED_PROXIES TRUST_CF_CONNECTING_IP SHARED_ADDRESSES HSTS
HTTPS_PROXY HTTP_PROXY NO_PROXY https_proxy http_proxy no_proxy NODE_EXTRA_CA_CERTS
DEPENDENCY_INDEX_URL DEPENDENCY_FILES_HOSTS COLLOQ_ROOM_NETWORK KERNEL_BLOCKED_CIDRS COLLOQ_HELPER_IMAGE
BACKUP_KEEP BACKUP_AGE_RECIPIENT COLLOQ_ALLOW_SCHEMA_DOWNGRADE COLLOQ_OFFLINE COLLOQ_ON_VAST
METRICS_TOKEN LOG_FORMAT DB_SNAPSHOT_HOURS DB_SNAPSHOT_KEEP
AUTH_JWT_JWKS_URL AUTH_JWT_JWKS_FILE AUTH_JWT_HEADER AUTH_JWT_ISSUER AUTH_JWT_AUDIENCE AUTH_JWT_ALGORITHMS
AUTH_JWT_LEEWAY_SECONDS AUTH_JWT_SUBJECT_CLAIM AUTH_JWT_NAME_CLAIM AUTH_JWT_EMAIL_CLAIM AUTH_JWT_ROLES_CLAIM
AUTH_JWT_EMAIL_DOMAIN AUTH_JWT_TEACHER_ROLES AUTH_JWT_OWNER_ROLES"

# Host-side settings `up` remembers in the same file, so that a later `update`,
# `restore` or `backup` acts on the same layout (see setting above). They reach
# the container's environment too, where they are the values colloq-host passes
# with -e anyway, or unused.
HOST_KEYS="COLLOQ_HOME COLLOQ_CONTAINER_NAME KERNEL_NETWORK PORT COLLOQ_BIND COLLOQ_FREEZE_UPDATES"

# What a machine for submissions keeps in runner.env, its container's only
# settings besides the join itself (COLLOQ_RUNNER_JOIN, written by `runner
# up`): the way out to the home (a proxy, an internal CA, which the agent
# honours as the server does), the zone and format of its log, the two Vast
# flags, where its tree is, and which repository its image comes from. None of
# the instance's: no relay, no tunnel, no assistant key, no sign-in, no
# database. A machine opens no address and serves nobody, and RELAY_TOKEN in
# particular never reaches one (a stolen machine is not a way onto the relay).
RUNNER_KEYS="HTTPS_PROXY HTTP_PROXY NO_PROXY https_proxy http_proxy no_proxy NODE_EXTRA_CA_CERTS TZ LOG_FORMAT
COLLOQ_ON_VAST COLLOQ_FREEZE_UPDATES COLLOQ_RUNNER_STATE COLLOQ_RUNNER_REPO COLLOQ_RUNNER_DRAIN_SEC"
# The keys write_env takes; runner_command sets it to RUNNER_KEYS.
ENV_KEYS=""

# ------------------------------------------------------------ settings
ensure_conf() {
  mkdir -p "$CONF_DIR"; chmod 0700 "$CONF_DIR"
  touch "$ENV_FILE"; chmod 0600 "$ENV_FILE"
}

# docker's --env-file format knows neither quotes nor line breaks: a value runs
# as is to the end of the line, and a line break inside it would break the file.
put_line() {
  local file="$1" key="$2" value="$3"
  case "$value" in *$'\n'*) die "$key contains a newline; docker --env-file cannot carry it" ;; esac
  grep -v "^${key}=" "$file" > "$file.next" || true
  mv "$file.next" "$file"
  printf '%s=%s\n' "$key" "$value" >> "$file"
}

write_env() {
  ensure_conf
  local key value tmp exported keys
  tmp="$(mktemp "$CONF_DIR/.colloq.env.XXXXXX")"
  cp "$ENV_FILE" "$tmp"
  # Only what the caller exported: the script's own variables are not settings.
  exported=" $(compgen -e | tr '\n' ' ') "
  # KERNEL_MEM_<ENVIRONMENT> is one variable per environment (pool.ts ·
  # memoryLimit: base-gpu → KERNEL_MEM_BASE_GPU), so they cannot be listed in
  # advance: every such variable in the caller's environment is taken. A
  # machine for submissions has a list of its own (ENV_KEYS = RUNNER_KEYS).
  keys="$ENV_KEYS"
  [ -n "$keys" ] || keys="$APP_KEYS $HOST_KEYS $(compgen -e | grep -E '^KERNEL_MEM_[A-Z0-9_]+$' || true)"
  for key in $keys; do
    case "$exported" in *" $key "*) ;; *) continue ;; esac
    # An empty value means "not given", not "erase": the template's on-start
    # declares every variable, and its empty strings must not wipe what the
    # operator added to the file by hand after renting. A key is removed by
    # editing the file.
    value="${!key:-}"
    [ -n "$value" ] || continue
    put_line "$tmp" "$key" "$value"
  done
  chmod 0600 "$tmp"; mv -f "$tmp" "$ENV_FILE"
}

set_env_value() {
  ensure_conf
  local tmp
  tmp="$(mktemp "$CONF_DIR/.colloq.env.XXXXXX")"
  cp "$ENV_FILE" "$tmp"
  put_line "$tmp" "$1" "$2"
  chmod 0600 "$tmp"; mv -f "$tmp" "$ENV_FILE"
}

# The image the instance lives on. One named explicitly (`update IMAGE`,
# `load`) is written to the file; COLLOQ_IMAGE from the environment only when
# there is no file yet, that is, on the first `up`. Otherwise a VM reboot after
# `colloq-host update` would roll the instance back: the on-start carries the
# image the template had at rental time, `up` would write it over, and the old
# server would come up on a database the new one had already moved forward.
image() {
  local named="${1:-}"
  if [ -n "$named" ]; then
    mkdir -p "$CONF_DIR"; printf '%s\n' "$named" > "$IMAGE_FILE"
  elif [ ! -s "$IMAGE_FILE" ] && [ -n "${COLLOQ_IMAGE:-}" ]; then
    mkdir -p "$CONF_DIR"; printf '%s\n' "$COLLOQ_IMAGE" > "$IMAGE_FILE"
  fi
  [ -s "$IMAGE_FILE" ] || die "no image named: set COLLOQ_IMAGE=ghcr.io/<owner>/colloq-vast:<version>"
  head -1 "$IMAGE_FILE"
}

# The same answer without writing anything: for doctor and bundle.
configured_image() {
  local img=""
  [ ! -s "$IMAGE_FILE" ] || img="$(head -1 "$IMAGE_FILE" 2>/dev/null || true)"
  printf '%s' "${img:-${COLLOQ_IMAGE:-}}"
}

offline() { [ "$(setting COLLOQ_OFFLINE)" = 1 ]; }

# A Vast VM: the flag its on-start sets, or, for an on-start copied before the
# flag existed, what scripts/vast-vm.sh leaves on every VM it rents (the
# on-start itself, in $CONF_DIR). Those older copies must keep the behaviour
# they were written for. COLLOQ_ON_VAST=0 says "not Vast" whatever else is here.
on_vast() {
  case "$(setting COLLOQ_ON_VAST)" in 1) return 0 ;; 0) return 1 ;; esac
  [ -f "$CONF_DIR/onstart.sh" ] || [ -n "${VAST_CONTAINERLABEL:-}" ]
}

# The freeze is asked for (COLLOQ_FREEZE_UPDATES=1, from the Vast on-start) or
# refused (=0). Unsaid, it follows on_vast: a Vast on-start from before the flag
# still means a throwaway VM, and anything else means a machine somebody keeps.
freeze_wanted() {
  case "$(setting COLLOQ_FREEZE_UPDATES)" in 1) return 0 ;; 0) return 1 ;; esac
  on_vast
}

# ------------------------------------------------------------- machine
#
# A plain Vast VM (ubuntu_cli) comes with docker and the driver; the rest is
# installed only when missing. The same set, for the same reasons, as
# scripts/vast-legacy.sh, minus the build: the machine no longer needs Node,
# npm or the sources. Offline (COLLOQ_OFFLINE=1) nothing is downloaded at all:
# what is missing is named, and installing it is the administrator's move.

# Another package manager holds the dpkg lock (unattended-upgrades right after
# boot, an administrator's apt): wait for it, and say so, instead of failing on
# the lock or, worse, killing it.
wait_dpkg_lock() {
  command -v fuser >/dev/null 2>&1 || return 0
  local waited=0
  while fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock >/dev/null 2>&1; do
    if [ "$waited" = 0 ]; then say "another package manager holds the dpkg lock (unattended-upgrades?); waiting for it"; fi
    waited=$((waited + 3))
    [ "$waited" -lt 600 ] || { warn "the dpkg lock is still held after 10 minutes; trying anyway"; return 0; }
    sleep 3
  done
}

apt_quiet() {
  command -v apt-get >/dev/null 2>&1 || return 1
  if freeze_wanted; then
    # A throwaway machine has no use for automatic updates, and their dpkg
    # lock broke the installation at the next step (13 Sep 2026).
    systemctl disable --now unattended-upgrades apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1 || true
  fi
  wait_dpkg_lock
  # DPkg::Lock::Timeout: apt waits for a lock taken between the check above and
  # this call, rather than giving up at once.
  DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 "$@"
}

# Only under COLLOQ_FREEZE_UPDATES=1, and then on every `up`, not only when apt
# is needed. On a VM that already had docker and the toolkit,
# unattended-upgrades stayed on and, 20 minutes after boot, upgraded the NVIDIA
# userspace to 580.178 while the loaded kernel module stayed 580.95:
# "Driver/library version mismatch" and no GPU until a reboot (28 Sep 2026). On
# a rented VM the driver must stay the one it booted with; a server somebody
# keeps reboots after its updates on its own schedule.
freeze_host_updates() {
  freeze_wanted || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  say "switching off automatic updates and holding the NVIDIA packages (COLLOQ_FREEZE_UPDATES=1)"
  systemctl disable --now unattended-upgrades apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1 || true
  command -v apt-mark >/dev/null 2>&1 || return 0
  local held
  held="$(dpkg-query -W -f '${db:Status-Status} ${Package}\n' 2>/dev/null | awk '$1 == "installed" && $2 ~ /nvidia/ { print $2 }')"
  # shellcheck disable=SC2086 # one word per package
  [ -z "$held" ] || apt-mark hold $held >/dev/null 2>&1 || true
}

ensure_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    if offline; then
      die "Docker is not installed, and COLLOQ_OFFLINE=1 downloads nothing: install Docker Engine 28 or newer from your distribution's packages or an internal mirror first (colloq-host doctor lists what else is missing)"
    fi
    say "installing docker from get.docker.com (install Docker Engine yourself beforehand to choose its version and repository)"
    wait_dpkg_lock
    curl -fsSL https://get.docker.com | sh >/dev/null
  fi
  # Enabled, so that Docker, and with it Colloq (--restart unless-stopped),
  # comes back after a reboot.
  systemctl enable --now docker >/dev/null 2>&1 || true
  local _
  for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && return 0; sleep 2; done
  die "the docker daemon does not answer"
}

ensure_gpu() {
  # runner: a machine for submissions, which probes and shares out its own
  # cards (the agent), so it gets the toolkit and the driver check, and no
  # list of cards for rooms it does not have.
  local role="${1:-}"
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    if [ "$role" = runner ]; then say "no NVIDIA GPU on this machine: it takes CPU submissions only"
    else say "no NVIDIA GPU on this machine; GPU environments will refuse to start"
    fi
    return 0
  fi
  nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader 2>/dev/null | sed 's/^/[colloq-host]   gpu /' || true
  # The driver is there, but without nvidia-container-toolkit docker does not
  # hand the card to a container: the kernel comes up without CUDA, and people
  # find out in class from torch.cuda.is_available() == False.
  #
  # An instance stops there: its GPU rooms are what it was set up for. A
  # machine for submissions does not. CPU submissions run on it whatever the
  # cards, and its agent finds no card through Docker and offers none, so a
  # host where the toolkit cannot be installed (no apt-get: a RHEL or an Arch
  # server; no way out to nvidia.github.io) joins as a CPU machine, said so,
  # rather than not at all.
  if ! docker info 2>/dev/null | grep -qi nvidia; then
    if offline; then
      if [ "$role" = runner ]; then
        warn "nvidia-container-toolkit is missing, and COLLOQ_OFFLINE=1 downloads nothing: this machine takes CPU submissions only until it is installed by hand (then nvidia-ctk runtime configure --runtime=docker, and colloq-host runner update)"
        return 0
      fi
      warn "nvidia-container-toolkit is missing, and COLLOQ_OFFLINE=1 downloads nothing: install it by hand (then nvidia-ctk runtime configure --runtime=docker), or GPU rooms get no card"
    elif ! install_container_toolkit; then
      if [ "$role" = runner ]; then
        warn "nvidia-container-toolkit could not be installed ($TOOLKIT_PROBLEM): this machine takes CPU submissions only until it is installed by hand (then nvidia-ctk runtime configure --runtime=docker, and colloq-host runner update)"
        return 0
      fi
      die "$TOOLKIT_PROBLEM: install nvidia-container-toolkit by hand"
    fi
  fi
  if [ "$role" = runner ]; then check_driver_floor; return 0; fi
  # The slices for rooms are card numbers in the form docker understands. A
  # list given by hand (MIG, some of the cards) is left alone.
  if [ -z "$(env_value KERNEL_GPUS)" ]; then
    local gpus
    gpus="$(nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null | paste -sd, - || true)"
    # nvidia-smi prints its failures on stdout: after a driver update under the
    # loaded kernel module (30 Sep 2026, on a VM that kept unattended-upgrades)
    # this line read "Failed to initialize NVML: Driver/library version
    # mismatch", and it went into KERNEL_GPUS as a list of cards. Only numbers
    # are a list; anything else is a machine that needs a reboot.
    case "$gpus" in
      '') : ;;
      *[!0-9,]*) warn "nvidia-smi does not answer (${gpus%%,*}): GPU rooms get no card until this is fixed; after a driver update that is usually a reboot" ;;
      *) printf 'KERNEL_GPUS=%s\n' "$gpus" >> "$ENV_FILE"
         say "rooms on GPU environments get one of: $gpus" ;;
    esac
  fi
}

# NVIDIA's own apt repository, the one way the toolkit is installed here. Every
# step is checked by hand, and TOOLKIT_PROBLEM names the one that failed: the
# function runs as a condition (ensure_gpu), where `set -e` stops nothing, and
# a machine for submissions goes on without the toolkit rather than with half
# of it.
TOOLKIT_PROBLEM=""
install_container_toolkit() {
  say "installing nvidia-container-toolkit"
  command -v apt-get >/dev/null 2>&1 || { TOOLKIT_PROBLEM="no apt-get"; return 1; }
  apt_quiet update -qq || { TOOLKIT_PROBLEM="apt-get update failed"; return 1; }
  apt_quiet install -y -qq curl gnupg ca-certificates >/dev/null || { TOOLKIT_PROBLEM="apt-get could not install curl and gnupg"; return 1; }
  curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
    | gpg --dearmor --yes -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg \
    || { TOOLKIT_PROBLEM="NVIDIA's signing key could not be fetched from nvidia.github.io"; return 1; }
  curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
    | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
    > /etc/apt/sources.list.d/nvidia-container-toolkit.list \
    || { TOOLKIT_PROBLEM="NVIDIA's package list could not be fetched from nvidia.github.io"; return 1; }
  apt_quiet update -qq || { TOOLKIT_PROBLEM="apt-get update failed with NVIDIA's repository"; return 1; }
  apt_quiet install -y -qq nvidia-container-toolkit >/dev/null || { TOOLKIT_PROBLEM="apt-get could not install nvidia-container-toolkit"; return 1; }
  nvidia-ctk runtime configure --runtime=docker >/dev/null || { TOOLKIT_PROBLEM="nvidia-ctk could not configure Docker"; return 1; }
  systemctl restart docker || { TOOLKIT_PROBLEM="Docker did not restart with the NVIDIA runtime"; return 1; }
  ensure_docker
}

# The GPU kernels are CUDA 13 builds (base-gpu pins torch 2.14.1+cu130), and
# CUDA 13 wants an NVIDIA driver of 580 or newer (shared/remote-runner.ts ·
# REMOTE_DRIVER_MIN): under an older one torch imports and never sees the card.
# The agent's smoke test refuses such a kernel anyway, with the reason in the
# home's panel («драйвер 535, нужен 580+»); it is said here first, to the
# person who can change the driver. Not a refusal: CPU submissions run
# whatever the driver.
check_driver_floor() {
  local driver major
  driver="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 | tr -d '[:space:]' || true)"
  major="${driver%%.*}"
  case "$major" in
    ''|*[!0-9]*)
      warn "nvidia-smi does not answer (${driver:-no driver version}): this machine takes CPU submissions only until it does; after a driver update that is usually a reboot" ;;
    *)
      if [ "$major" -lt 580 ]; then
        warn "NVIDIA driver $driver: the GPU kernels need 580 or newer, so this machine takes CPU submissions only"
      else
        say "NVIDIA driver $driver: GPU submissions can run here"
      fi ;;
  esac
}

registry_login() {
  [ -n "${COLLOQ_REGISTRY_TOKEN:-}" ] || return 0
  offline && return 0
  local registry="${1%%/*}"
  printf '%s' "$COLLOQ_REGISTRY_TOKEN" \
    | docker login "$registry" -u "${COLLOQ_REGISTRY_USER:-colloq}" --password-stdin >/dev/null \
    || die "docker login $registry failed"
  say "logged in to $registry"
}

# Pull, unless pulls are off; a failed pull is fatal only when there is no copy
# here to run. The copy is what an offline server has (colloq-host load), what a
# registry outage leaves, and what a rollback to a local tag names.
fetch_image() {
  local img="$1"
  if offline || [ "${COLLOQ_PULL:-1}" = 0 ]; then
    docker image inspect "$img" >/dev/null 2>&1 && return 0
    offline && die "$img is not on this machine, and COLLOQ_OFFLINE=1 allows no pulls: bring it with colloq-host bundle (on a connected machine) and colloq-host load (here)"
    die "$img is not on this machine, and COLLOQ_PULL=0 skips the pull"
  fi
  say "pulling $img"
  docker pull -q "$img" >/dev/null && return 0
  docker image inspect "$img" >/dev/null 2>&1 || die "could not pull $img"
  warn "could not pull $img; running the copy already on this machine"
}

# ----------------------------------------------------------- container
#
# The fingerprint of the settings and the image is a label on the container: a
# repeated on-start (a VM reboot) with the same settings leaves the live
# instance alone, and changed ones recreate it. Files and the database live in
# $STATE and survive that.
#
# The file is hashed sorted: write_env moves every rewritten key to the end, and
# ensure_gpu appends KERNEL_GPUS last, so the line order changes from boot to
# boot with the same values. Without sort the second boot of a GPU machine (and
# any manual `up` with some of the variables) would recreate the live container,
# which in the middle of a class cuts off the whole group.
config_sum() {
  { printf '%s\n' "$1"; docker image inspect -f '{{.Id}}' "$1" 2>/dev/null; sort "$ENV_FILE"; printf '%s %s\n' "$(bind_addr)" "$LISTEN_PORT"; config_extras "$2"; } \
    | sha256sum | cut -c1-16
}

# What else the container is made from: the trusted-proxy default, and the
# content of an internal CA bundle, which Node reads only at start.
config_extras() {
  [ -z "$1" ] || printf 'trusted %s\n' "$1"
  local ca; ca="$(env_value NODE_EXTRA_CA_CERTS)"
  if [ -n "$ca" ] && [ -f "$ca" ]; then printf 'ca %s\n' "$(sha256sum < "$ca" | cut -c1-64)"; fi
}

bind_addr() {
  # Colloq goes outside through a tunnel or the host's own proxy, and the port
  # on the machine's public address would be a second door into the same room
  # (see deploy/colloq-legacy.service, BIND_ADDR). Loopback by default; all
  # interfaces in direct mode, or any address asked for with COLLOQ_BIND (a
  # proxy on another host needs the address it reaches).
  local asked; asked="$(setting COLLOQ_BIND)"
  if [ -n "$asked" ]; then printf '%s' "$asked"
  elif [ "$(env_value COLLOQ_TUNNEL)" = direct ]; then printf '0.0.0.0'
  else printf '127.0.0.1'
  fi
}

is_loopback() {
  case "$1" in 127.*|localhost|::1|'[::1]') return 0 ;; esac
  return 1
}

# Whose X-Forwarded-For the server believes when the operator has not said
# (TRUSTED_PROXIES). With the port on loopback only processes on this machine
# can connect at all, and Docker's port proxy hands their connections to the
# container from the network's gateway, not from 127.0.0.1: a reverse proxy on
# this host would otherwise look like one client for the whole class, and the
# per-address caps would turn the 61st student away. Trusting the gateway is
# trusting this machine, as loopback already is. A published port on another
# address is not assumed anything about: there the proxy's address is the
# operator's to name, and doctor says so.
trusted_default() {
  [ -z "$(env_value TRUSTED_PROXIES)" ] || return 0
  is_loopback "$(bind_addr)" || return 0
  local gw
  gw="$(docker network inspect -f '{{range .IPAM.Config}}{{.Gateway}} {{end}}' "$NET" 2>/dev/null | xargs | tr ' ' ',' || true)"
  printf 'loopback%s' "${gw:+,$gw}"
}

run_container() {
  local img="$1" sum trusted ca extra=()
  docker network inspect "$NET" >/dev/null 2>&1 || docker network create "$NET" >/dev/null
  trusted="$(trusted_default)"
  sum="$(config_sum "$img" "$trusted")"
  if docker container inspect "$NAME" >/dev/null 2>&1; then
    if [ "$(docker inspect -f '{{index .Config.Labels "colloq.config"}}' "$NAME")" = "$sum" ]; then
      docker start "$NAME" >/dev/null 2>&1 || true
      say "$NAME is already running with these settings"
      return 0
    fi
    say "replacing $NAME (new image or settings); room kernels keep running"
    docker stop -t 30 "$NAME" >/dev/null 2>&1 || true
    docker rm "$NAME" >/dev/null
  fi
  mkdir -p "$STATE"
  # The registry credentials go in as a copy: the CLI in the container pulls
  # environment kernels from a private registry and needs its own config.json
  # (the entry point moves it into the node user's ~/.docker).
  if [ -s /root/.docker/config.json ]; then
    extra+=(-v /root/.docker/config.json:/run/colloq/docker-config.json:ro)
  fi
  # An internal CA bundle is a file on the host: mounted at the same path, so
  # that NODE_EXTRA_CA_CERTS means the same file to the server and to the
  # daemon, which resolves the path when the server hands it to a container of
  # its own.
  ca="$(env_value NODE_EXTRA_CA_CERTS)"
  if [ -n "$ca" ]; then
    if [ -f "$ca" ]; then extra+=(-v "$ca:$ca:ro")
    else warn "NODE_EXTRA_CA_CERTS=$ca is not a file on this machine; the container gets the path as it is"
    fi
  fi
  [ -z "$trusted" ] || extra+=(-e "TRUSTED_PROXIES=$trusted")
  # COLLOQ_SERVER_IMAGE: the panel's join commands for the machines that run
  # submissions name this very image (competitions/remote/commands.ts), so a
  # machine joined from the panel runs the build its home runs, as the
  # commands `colloq-host runner-code` prints do. A container started without
  # it (by a colloq-host from before it, or by hand) has its entry point ask
  # the daemon instead (entrypoint.sh · locate_server_image).
  docker run -d --name "$NAME" \
    --restart unless-stopped \
    --network "$NET" \
    --stop-timeout 30 \
    --log-opt max-size=50m --log-opt max-file=5 \
    -p "$(bind_addr):${LISTEN_PORT}:${LISTEN_PORT}" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$STATE:$STATE" \
    ${extra[@]+"${extra[@]}"} \
    --env-file "$ENV_FILE" \
    -e "COLLOQ_HOME=$STATE" -e "PORT=$LISTEN_PORT" -e "KERNEL_NETWORK=$NET" \
    -e "COLLOQ_SERVER_IMAGE=$img" \
    --label colloq.kind=app --label "colloq.config=$sum" \
    "$img" >/dev/null
  say "started $NAME from $img"
}

wait_ready() {
  local _
  for _ in $(seq 1 120); do
    # --noproxy: an HTTP_PROXY meant for the internet must not catch a call to
    # the container's own loopback.
    if docker exec "$NAME" curl -fsS --noproxy '*' -o /dev/null --max-time 2 "http://127.0.0.1:${LISTEN_PORT}/api/livez" 2>/dev/null; then
      docker exec "$NAME" colloq-vast link || true
      say "the default environment is prepared in the background; watch: colloq-host logs"
      say "ready for a class when this is green: colloq-host status"
      return 0
    fi
    [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = true ] || break
    sleep 2
  done
  docker logs --tail 60 "$NAME" >&2 || true
  die "$NAME did not come up; the log is above"
}

up() {
  need_root
  # Named in the settings, so that the container knows it too (the entry point
  # keeps the quick tunnel for Vast) and a later `up` needs no detection.
  if on_vast; then export COLLOQ_ON_VAST=1; fi
  freeze_host_updates
  ensure_docker
  write_env
  ensure_gpu
  local img; img="$(image)"
  if [ -n "${COLLOQ_IMAGE:-}" ] && [ "$COLLOQ_IMAGE" != "$img" ]; then
    warn "keeping $img, the image colloq-host update chose; COLLOQ_IMAGE=$COLLOQ_IMAGE only names the first one. To switch: colloq-host update <image>"
  fi
  registry_login "$img"
  fetch_image "$img"
  run_container "$img"
  wait_ready
}

# ------------------------------------------------------------- backups
newest_backup() {
  # shellcheck disable=SC2012 # names are ours: colloq-<stamp>.db
  ls -1t "$STATE"/backups/colloq-*.db 2>/dev/null | head -1 || true
}

# A backup by the running server's own command; with the container stopped, by
# a one-off container of the same image (nothing writes then, and the copy is
# as consistent). BACKUP_KEEP goes along explicitly: `docker exec` sees the
# environment the container was created with, and a keep count changed in
# colloq.env since then must apply to this backup already. Sets BACKUP_DB to
# the new database copy, if one appeared.
BACKUP_DB=""
backup_now() {
  local fallback="${1:-}" before keep_count keep=() envfile=() img
  before="$(newest_backup)"
  keep_count="$(setting BACKUP_KEEP)"
  [ -z "$keep_count" ] || keep=(-e "BACKUP_KEEP=$keep_count")
  if [ "$(docker container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || true)" = true ]; then
    docker exec ${keep[@]+"${keep[@]}"} "$NAME" colloq-vast backup || return 1
  else
    img="${fallback:-$(image)}"
    say "$NAME is not running; the backup comes from a one-off container of $img"
    [ ! -f "$ENV_FILE" ] || envfile=(--env-file "$ENV_FILE")
    docker run --rm -v "$STATE:$STATE" ${envfile[@]+"${envfile[@]}"} -e "COLLOQ_HOME=$STATE" \
      ${keep[@]+"${keep[@]}"} "$img" backup || return 1
  fi
  BACKUP_DB="$(newest_backup)"
  [ "$BACKUP_DB" != "$before" ] || BACKUP_DB=""
}

# A name that will still mean the image the container runs now, after the pull
# of a new one: the name in the image file if its tag still points there; else
# another tag of that image that is not `latest` (after `load` has already
# named the new version in the file, the old one still has its own); else the
# registry digest (pullable for as long as the registry keeps it); else a local
# tag that keeps the image from being pruned (an image loaded offline has no
# digest).
rollback_ref() {
  local id="$1" name digest local_tag
  name="$(configured_image)"
  if [ -n "$name" ] && [ "$(docker image inspect -f '{{.Id}}' "$name" 2>/dev/null || true)" = "$id" ]; then
    printf '%s' "$name"; return 0
  fi
  name="$(docker image inspect -f '{{range .RepoTags}}{{println .}}{{end}}' "$id" 2>/dev/null | grep -v ':latest$' | head -1 || true)"
  if [ -n "$name" ]; then printf '%s' "$name"; return 0; fi
  digest="$(docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$id" 2>/dev/null | head -1 || true)"
  if [ -n "$digest" ]; then printf '%s' "$digest"; return 0; fi
  local_tag="colloq-previous:$(date +%Y%m%d-%H%M%S)"
  if docker tag "$id" "$local_tag" >/dev/null 2>&1; then printf '%s' "$local_tag"; else printf '%s' "$id"; fi
}

# Before a new version meets the database, a copy of it: the new server may
# move the schema forward, and the old one is not tested against a newer schema
# (README, "Update"). The way back is printed before anything is replaced, so
# that it is on the screen even if the new version never comes up.
backup_before_update() {
  local id="$1" prev="$2"
  if [ "${COLLOQ_BACKUP_BEFORE_UPDATE:-1}" = 0 ]; then
    warn "no backup before this update (COLLOQ_BACKUP_BEFORE_UPDATE=0)"
    return 0
  fi
  if [ ! -f "$STATE/data/colloq.db" ]; then
    say "no database yet; nothing to back up before the update"
    return 0
  fi
  say "backing up before the update (COLLOQ_BACKUP_BEFORE_UPDATE=0 skips this)"
  backup_now "$id" || die "the backup before the update failed, and nothing was changed: $NAME still runs $prev. Free some disk and retry, or skip the backup with COLLOQ_BACKUP_BEFORE_UPDATE=0"
  if [ -n "$BACKUP_DB" ]; then
    say "backup before the update: $BACKUP_DB"
    say "to go back to $prev with the data as it is now:"
    say "  REPLACE=1 colloq-host restore --image $prev $BACKUP_DB"
  else
    warn "the backup ran, but no new $STATE/backups/colloq-*.db appeared; look at its output above before trusting this update"
  fi
}

update() {
  need_root
  local img cur_id new_id prev=""
  img="${1:-}"
  [ -n "$img" ] || img="$(image)"
  registry_login "$img"
  fetch_image "$img"
  new_id="$(docker image inspect -f '{{.Id}}' "$img")"
  cur_id="$(docker container inspect -f '{{.Image}}' "$NAME" 2>/dev/null || true)"
  if [ -n "$cur_id" ] && [ "$cur_id" != "$new_id" ]; then
    prev="$(rollback_ref "$cur_id")"
    backup_before_update "$cur_id" "$prev"
  fi
  image "$img" >/dev/null
  run_container "$img"
  wait_ready
  if [ -n "$prev" ]; then
    # The manager moves with the image it manages: a newer image may count on
    # settings or steps this older script does not know, and an operator who
    # updated with one command should not have to remember a second. The
    # image's `install` writes a new file rather than rewriting this one, so
    # the copy bash is reading right now reads on undisturbed.
    if [ -w "$HOST_BIN" ] && docker run --rm -v "$HOST_BIN:/host" "$img" install-host /host >/dev/null 2>&1; then
      say "colloq-host itself updated from $img"
    else
      warn "colloq-host itself is still the one from before; the new one: docker run --rm -v $HOST_BIN:/host $img install-host /host"
    fi
  fi
}

restore() {
  need_root
  local img tty=() named=""
  if [ "${1:-}" = --image ]; then
    named="${2:-}"
    [ -n "$named" ] || die "usage: colloq-host restore [--image IMAGE] [FILES]"
    shift 2
    fetch_image "$named"
    img="$named"
  else
    img="$(image)"
  fi
  [ -t 0 ] && tty=(-it)
  say "stopping $NAME: a database is never swapped under a running server"
  docker stop -t 30 "$NAME" >/dev/null 2>&1 || true
  # An encrypted backup opens with the age identity, a file on this host that
  # must not live next to the archives: mounted read-only at the same path for
  # this one container, and never written into colloq.env.
  local identity=()
  if [ -n "${BACKUP_AGE_IDENTITY:-}" ]; then
    [ -f "$BACKUP_AGE_IDENTITY" ] || die "BACKUP_AGE_IDENTITY=$BACKUP_AGE_IDENTITY is not a file on this machine"
    identity=(-v "$BACKUP_AGE_IDENTITY:$BACKUP_AGE_IDENTITY:ro" -e "BACKUP_AGE_IDENTITY=$BACKUP_AGE_IDENTITY")
  fi
  docker run --rm ${tty[@]+"${tty[@]}"} -v "$STATE:$STATE" -e "COLLOQ_HOME=$STATE" -e "REPLACE=${REPLACE:-}" \
    ${identity[@]+"${identity[@]}"} \
    "$img" restore "$@" || { docker start "$NAME" >/dev/null 2>&1 || true; die "restore failed; $NAME is back as it was"; }
  # The image is recorded only now: a restore that failed leaves the instance on
  # the version it had. run_container then starts the same container, or,
  # after --image, recreates it on that image: a rollback is the old server on
  # the old data, never the new server migrating the old data forward again.
  [ -z "$named" ] || image "$named" >/dev/null
  run_container "$img"
  wait_ready
}

# ------------------------------------------------------ nightly backups
#
# A systemd timer, not cron: Persistent=true runs a backup the machine slept
# through as soon as it is back, and `systemctl list-timers` shows the next run
# and the last one. The service is colloq-host backup itself; how many archives
# stay is the backup script's business (BACKUP_KEEP, default 14).
backup_timer() {
  need_root
  local action="${1:-status}" at exec_path
  command -v systemctl >/dev/null 2>&1 || die "no systemctl here: schedule \`colloq-host backup\` with cron instead"
  case "$action" in
    on)
      at="${COLLOQ_BACKUP_AT:-03:30}"
      case "$at" in
        [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) at="$at:00" ;;
        [01][0-9]:[0-5][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]:[0-5][0-9]) ;;
        *) die "COLLOQ_BACKUP_AT=$at is not a time of day; give HH:MM, e.g. 03:30" ;;
      esac
      if [ -n "${BACKUP_KEEP:-}" ]; then
        case "$BACKUP_KEEP" in *[!0-9]*) die "BACKUP_KEEP=$BACKUP_KEEP is not a number of archives" ;; esac
        set_env_value BACKUP_KEEP "$BACKUP_KEEP"
      fi
      exec_path="$HOST_BIN/colloq-host"
      [ -x "$exec_path" ] || exec_path="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
      mkdir -p "$SYSTEMD_DIR"
      {
        printf '[Unit]\n'
        printf 'Description=Colloq backup (colloq-host backup)\n'
        printf 'Wants=docker.service\nAfter=docker.service\n\n'
        printf '[Service]\n'
        printf 'Type=oneshot\n'
        printf 'ExecStart=%s backup\n' "$exec_path"
        [ "$CONF_DIR" = /etc/colloq ] || printf 'Environment=COLLOQ_CONF_DIR=%s\n' "$CONF_DIR"
        # A bound, not a guess at the size: a backup that hangs must not keep
        # every following night's from starting.
        printf 'TimeoutStartSec=6h\n'
      } > "$SYSTEMD_DIR/colloq-backup.service"
      {
        printf '[Unit]\n'
        printf 'Description=Colloq backup every day at %s\n\n' "$at"
        printf '[Timer]\n'
        printf 'OnCalendar=*-*-* %s\n' "$at"
        printf 'Persistent=true\n'
        printf 'Unit=colloq-backup.service\n\n'
        printf '[Install]\nWantedBy=timers.target\n'
      } > "$SYSTEMD_DIR/colloq-backup.timer"
      systemctl daemon-reload
      systemctl enable --now colloq-backup.timer >/dev/null
      say "a backup every day at $at (this machine's time zone) into $STATE/backups/; $(setting BACKUP_KEEP 14) archives are kept"
      say "copy them off this machine too: a backup on the disk it protects is half a backup"
      ;;
    off)
      systemctl disable --now colloq-backup.timer >/dev/null 2>&1 || true
      rm -f "$SYSTEMD_DIR/colloq-backup.timer" "$SYSTEMD_DIR/colloq-backup.service"
      systemctl daemon-reload
      say "nightly backups are off; the archives already taken stay in $STATE/backups/"
      ;;
    status)
      if [ ! -f "$SYSTEMD_DIR/colloq-backup.timer" ]; then
        say "nightly backups are off (colloq-host backup-timer on)"
      else
        systemctl list-timers --all --no-pager colloq-backup.timer 2>/dev/null || true
        systemctl status --no-pager --lines=5 colloq-backup.service 2>/dev/null || true
      fi
      local last; last="$(newest_backup)"
      say "latest backup: ${last:-none in $STATE/backups/}"
      ;;
    *) die "usage: colloq-host backup-timer on|off|status" ;;
  esac
}

# ------------------------------------------------------ offline install
#
# A campus server without internet gets everything in one file, made on a
# machine that has it:
#
#   connected$ colloq-host bundle colloq-0.9.0.tar ghcr.io/colloq-edu/colloq-vast:0.9.0
#   server$    tar -xf colloq-0.9.0.tar colloq-host && ./colloq-host load colloq-0.9.0.tar
#   server$    colloq-host up
#
# The file is a plain tar of three members: manifest.txt (what is inside, one
# line per image), colloq-host (the host script of that very version, so the
# server needs nothing else to read the file) and images.tar (`docker save` of
# the app image and the room kernels). Docker itself is not in it: installing
# Docker Engine is the administrator's, from the distribution or a mirror.

image_label() { docker image inspect -f "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null || true; }
image_id() { docker image inspect -f '{{.Id}}' "$1" 2>/dev/null || true; }

# NAME and its parents (`# colloq: from`), parents first, into BUNDLE_ENVS. A
# child's published image carries its parent's layers already; the parents go
# along because rooms default to base, and because `docker save` stores the
# shared layers once.
BUNDLE_ENVS=""
BUNDLE_DIR=""
bundle_closure() {
  local dir="$1" name="$2" depth="${3:-0}" parent
  [ "$depth" -lt 8 ] || die "the environments around \"$name\" inherit from each other in a circle"
  case " $BUNDLE_ENVS " in *" $name "*) return 0 ;; esac
  [ -f "$dir/$name.txt" ] || die "the image has no environment called \"$name\" (KERNEL_PRELOAD, KERNEL_ENV)"
  parent="$(sed -nE 's/^[[:space:]]*#[[:space:]]*colloq:[[:space:]]*from[[:space:]]+([^[:space:]]+)[[:space:]]*$/\1/p' "$dir/$name.txt" | head -1)"
  [ -z "$parent" ] || bundle_closure "$dir" "$parent" $((depth + 1))
  BUNDLE_ENVS="$BUNDLE_ENVS $name"
}

bundle() {
  local out="${1:-}" app="${2:-}" platform version dir cid wanted repo tag name ref source
  local refs=() lines=() save_flags=()
  [ -n "$out" ] || die "usage: colloq-host bundle FILE [IMAGE]   (FILE: the archive to write, e.g. colloq-0.9.0.tar)"
  [ ! -e "$out" ] || die "$out already exists; name a new file"
  [ -n "$app" ] || app="$(configured_image)"
  [ -n "$app" ] || die "which Colloq image? colloq-host bundle $out ghcr.io/colloq-edu/colloq-vast:<version>"
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 || die "bundle needs a running Docker on this machine"
  # The server's platform, not this machine's: a laptop on arm64 packs for an
  # amd64 server, and nothing is run here, only pulled and copied.
  platform="${COLLOQ_BUNDLE_PLATFORM:-linux/amd64}"
  [ -d "$(dirname "$out")" ] || die "no directory $(dirname "$out") to write $out into"
  # Next to the archive, not in /tmp: the images pass through here once, and
  # /tmp is often a small tmpfs.
  dir="$(mktemp -d "$(cd "$(dirname "$out")" && pwd -P)/.colloq-bundle.XXXXXX")"
  BUNDLE_DIR="$dir"
  trap 'rm -rf "$BUNDLE_DIR"' EXIT

  say "pulling $app ($platform)"
  if ! docker pull -q --platform "$platform" "$app" >/dev/null; then
    docker image inspect "$app" >/dev/null 2>&1 || die "could not pull $app"
    warn "could not pull $app; packing the copy already on this machine"
  fi
  version="$(image_label "$app" org.opencontainers.image.version)"
  version="${version:-unknown}"

  # The environment lists and the host script of exactly this version, copied
  # out of the image without running it.
  cid="$(docker create --platform "$platform" "$app")"
  docker cp "$cid:/opt/colloq/kernel/environments" "$dir/environments" >/dev/null \
    && docker cp "$cid:/opt/colloq/deploy/vast/colloq-host" "$dir/colloq-host" >/dev/null \
    || { docker rm "$cid" >/dev/null 2>&1 || true; die "$app does not look like a colloq-vast image (no kernel/environments or colloq-host in it)"; }
  docker rm "$cid" >/dev/null
  chmod 0755 "$dir/colloq-host"

  wanted="$(setting KERNEL_PRELOAD)"
  [ -n "$wanted" ] || wanted="$(setting KERNEL_ENV base)"
  for name in $(printf '%s' "$wanted" | tr ',' ' '); do
    bundle_closure "$dir/environments" "$name"
  done
  # The kernels the server would pull itself: KERNEL_IMAGE_REPO, else the
  # default this image was built with (publish.yml bakes the publisher's in).
  repo="$(setting KERNEL_IMAGE_REPO)"
  if [ -z "$repo" ]; then
    repo="$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$app" 2>/dev/null | sed -n 's/^COLLOQ_KERNEL_REPO=//p' | head -1 || true)"
  fi
  repo="${repo:-ghcr.io/colloq-edu/colloq-kernel}"
  tag="$(setting KERNEL_IMAGE_TAG "v$version")"
  refs=("$app")
  for name in $BUNDLE_ENVS; do
    ref=""; source=""
    case "$version" in unknown|0.0.0*|*-dev) ;; *)
      if [ "$repo" != none ] && docker pull -q --platform "$platform" "$repo:$tag-$name" >/dev/null 2>&1; then
        ref="$repo:$tag-$name"; source=published
      fi ;;
    esac
    if [ -z "$ref" ] && docker image inspect "colloq-kernel:$name" >/dev/null 2>&1; then
      ref="colloq-kernel:$name"; source=local
      warn "packing this machine's colloq-kernel:$name: $repo:$tag-$name could not be pulled, and a local build is not the published image for $version"
    fi
    [ -n "$ref" ] || die "no image for the \"$name\" environment: $repo:$tag-$name could not be pulled, and this machine has no colloq-kernel:$name"
    say "kernel $name: $ref"
    refs+=("$ref")
    lines+=("kernel $name $ref $(image_id "$ref") $source")
  done

  # Only the server's platform: with Docker's containerd store an image pulled
  # for one platform cannot be saved as the whole multi-platform index.
  if docker save --help 2>/dev/null | grep -q -- '--platform'; then save_flags=(--platform "$platform"); fi
  say "saving ${#refs[@]} images (several gigabytes; this takes a few minutes)"
  docker save ${save_flags[@]+"${save_flags[@]}"} -o "$dir/images.tar" "${refs[@]}"
  {
    printf '# colloq-host bundle: on the server, colloq-host load <this file>\n'
    printf 'format 1\n'
    printf 'created %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'version %s\n' "$version"
    printf 'platform %s\n' "$platform"
    printf 'app %s %s\n' "$app" "$(image_id "$app")"
    printf '%s\n' ${lines[@]+"${lines[@]}"}
  } > "$dir/manifest.txt"
  case "$out" in
    *.gz|*.tgz) tar -czf "$out" -C "$dir" manifest.txt colloq-host images.tar ;;
    *) tar -cf "$out" -C "$dir" manifest.txt colloq-host images.tar ;;
  esac
  rm -rf "$dir"; trap - EXIT
  say "wrote $out ($(du -h "$out" | cut -f1)): Colloq $version and the kernels$BUNDLE_ENVS"
  say "on the server (Docker Engine installed, no network needed):"
  say "  tar -xf $(basename "$out") colloq-host && ./colloq-host load $(basename "$out")"
}

load() {
  need_root
  local file="${1:-}" manifest app="" kinds="" kind a b pair env ref
  [ -n "$file" ] && [ -f "$file" ] || die "usage: colloq-host load FILE   (an archive written by colloq-host bundle)"
  command -v docker >/dev/null 2>&1 || die "Docker is not installed. An offline server gets no Docker from the network: install Docker Engine 28 or newer from your distribution's packages or an internal mirror, then run load again"
  docker info >/dev/null 2>&1 || die "the docker daemon does not answer: systemctl start docker"
  manifest="$(tar -xOf "$file" manifest.txt 2>/dev/null)" || die "$file is not a colloq-host bundle (no manifest.txt in it)"
  printf '%s\n' "$manifest" | grep -qx 'format 1' || die "$file is a bundle of a format this colloq-host does not know; use the colloq-host inside it"
  while read -r kind a b _; do
    case "$kind" in
      app) app="$a" ;;
      kernel) kinds="$kinds $a=$b" ;;
    esac
  done <<EOF
$manifest
EOF
  [ -n "$app" ] || die "$file names no app image"
  say "loading the images from $file (several gigabytes; a few minutes)"
  tar -xOf "$file" images.tar | docker load || die "docker load failed; the archive may be incomplete (compare its size with the one written)"
  docker image inspect "$app" >/dev/null 2>&1 || die "$app is not among the loaded images"
  for pair in $kinds; do
    env="${pair%%=*}"; ref="${pair#*=}"
    docker image inspect "$ref" >/dev/null 2>&1 || die "$ref is not among the loaded images"
    if [ -f "$STATE/environments/$env.txt" ]; then
      # This server has a list of its own under that name; its image is not
      # the published one, and replacing it would put the wrong packages
      # under a stamp that says otherwise.
      warn "kept colloq-kernel:$env: this server has its own \"$env\" list ($STATE/environments/$env.txt); the bundle's image stays as $ref"
      continue
    fi
    [ "$ref" = "colloq-kernel:$env" ] || docker tag "$ref" "colloq-kernel:$env"
    say "colloq-kernel:$env ← $ref"
  done
  image "$app" >/dev/null
  set_env_value COLLOQ_OFFLINE 1
  say "$IMAGE_FILE → $app; COLLOQ_OFFLINE=1 in $ENV_FILE: up and update pull nothing and install nothing"
  if docker run --rm -v "$HOST_BIN:/host" "$app" install-host /host >/dev/null 2>&1; then
    say "installed $HOST_BIN/colloq-host from $app"
  fi
  say "next: colloq-host doctor, then colloq-host up (a first install) or colloq-host update (a running one)"
}

# ---------------------------------------------- a machine for submissions
#
# `runner up` joins this machine to a home with its owner's code, `runner
# update` moves it to the home's version, `runner leave` takes it away. The
# rest is the agent's (dist/runner.js in the image): it pulls the kernels by
# digest and prefetches the data it is asked for, takes leases, runs each
# notebook in a container of its own on this Docker, uploads the answers. The
# metric, the hidden answers and the database never leave the home. All this
# script does is say `docker run` once, with the socket and the tree, and
# again after an update.

runner_usage() {
  cat <<'USAGE'
colloq-host runner: this machine runs another Colloq instance's submissions

  colloq-host runner up URL CODE [IMAGE] [--classes]
                                           join the home at URL with its owner's code; --classes, for a
                                           code that takes classes: check first that this machine can
  colloq-host runner update [VERSION|IMAGE] [--now]
                                           move to the home's version (or the one named): the runs it
                                           holds finish first; --now hands them back to the home's queue;
                                           its classes keep running
  colloq-host runner status                joined and syncing (exit 0), as JSON; its tunnel and classes
  colloq-host runner logs                  follow the agent's log (Ctrl+C to leave)
  colloq-host runner leave [--force]       finish its runs, revoke itself on the home, remove the container;
                                           a machine with classes asks first (--force moves them off it,
                                           their variables lost)

The code comes from the home's owner: the panel (Resources → Machines →
Connect a machine) or colloq-host runner-code on the home. Settings:
/etc/colloq/runner.env; the image: /etc/colloq/runner-image; the tree:
/var/lib/colloq-runner (COLLOQ_RUNNER_STATE: a directory of its own). A
machine joined with the panel's plain `docker run` is taken over by the first
update, leave, status or logs: its settings are read out of its container.
Nothing else should run on the machine's Docker: it is its home's whole.
USAGE
}

runner_command() {
  ENV_FILE="$RUNNER_ENV_FILE"
  ENV_KEYS="$RUNNER_KEYS"
  RUNNER_STATE="$(setting COLLOQ_RUNNER_STATE /var/lib/colloq-runner)"
  # It goes into `-v PATH:PATH` and to the agent, which hands the same path to
  # the daemon: absolute, plain, and the agent's alone (runner_state_problem).
  [ "$RUNNER_STATE" = / ] || RUNNER_STATE="${RUNNER_STATE%/}"
  local problem sub="${1:-help}"
  problem="$(runner_state_problem "$RUNNER_STATE" "$STATE")"
  [ -z "$problem" ] || die "COLLOQ_RUNNER_STATE=$problem"
  [ "$#" -eq 0 ] || shift
  case "$sub" in
    up) runner_up "$@" ;;
    update) runner_update "$@" ;;
    status) runner_status ;;
    logs) need_root; adopt_runner quiet; exec docker logs -f --tail 200 "$RUNNER_NAME" ;;
    leave) runner_leave "$@" ;;
    help|-h|--help) runner_usage ;;
    *) die "unknown command: runner $sub (colloq-host runner help)" ;;
  esac
}

# The tree is the agent's alone. The entry point hands it to uid 1000 whole
# (every file under it chowned, the top made 0700) and the agent evicts what
# it does not know there, so a system directory named by mistake,
# COLLOQ_RUNNER_STATE=/var or /home, would be handed over the same way, and
# the host with it. It must be a directory of its own: the default
# /var/lib/colloq-runner, or one under /srv, /data, /mnt or /opt, never a
# system root, a directory every Linux keeps its own files in, Docker's own
# store, a person's home itself, or the instance's state directory (the second
# argument) on a machine that has one. Prints what is wrong, nothing when the
# path will do. The entry point holds a copy of this function, which does the
# chown (tests/vast-runner-host.test.mts keeps the two the same); here it is
# said before anything is pulled.
runner_state_problem() {
  local p="$1" home="${2:-}" own="a system directory: give the machine's tree a directory of its own, like /var/lib/colloq-runner, /srv/colloq-runner or /data/colloq-runner"
  case "$p" in
    /*) ;;
    *) printf '%s is not an absolute path' "$p"; return 0 ;;
  esac
  case "$p" in
    *:*|*[[:space:]]*) printf '%s: a path without colons or spaces, please' "$p"; return 0 ;;
    *//*|*/./*|*/../*|*/.|*/..) printf '%s: a plain path, please, without . or .. or //' "$p"; return 0 ;;
  esac
  case "$p" in
    /home/*/*|/root/?*) ;;
    /|/bin|/boot|/data|/dev|/etc|/home|/home/*|/lib|/lib32|/lib64|/libx32|/lost+found|/media|/mnt|/opt|/proc \
    |/root|/run|/sbin|/snap|/srv|/sys|/tmp|/usr|/var|/workspace \
    |/var/backups|/var/cache|/var/lib|/var/local|/var/lock|/var/log|/var/mail|/var/opt|/var/run|/var/spool|/var/tmp \
    |/bin/*|/boot/*|/dev/*|/etc/*|/lib/*|/lib32/*|/lib64/*|/libx32/*|/proc/*|/run/*|/sbin/*|/snap/*|/sys/*|/usr/* \
    |/var/lock/*|/var/log/*|/var/run/*|/var/lib/docker|/var/lib/docker/*|/var/lib/containerd|/var/lib/containerd/* \
    |/opt/colloq|/opt/colloq/*)
      printf '%s is %s' "$p" "$own"; return 0 ;;
  esac
  [ -n "$home" ] || return 0
  [ "$p" != "${home%/}" ] || { printf "%s is the instance's state directory" "$p"; return 0; }
  case "$p/" in "${home%/}/"*) printf "%s is inside the instance's state directory %s" "$p" "$home"; return 0 ;; esac
  case "${home%/}/" in "$p/"*) printf "%s holds the instance's state directory %s" "$p" "$home"; return 0 ;; esac
  return 0
}

# The home as the agent keeps it (shared/remote-runner.ts · homeOrigin): an
# http(s) origin and nothing after it. A path, a query or a user in it would
# ride along with every call the machine makes, and the code goes after a `#`
# precisely so that it never travels in a request line.
check_home() {
  local rest re='^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?$'
  case "$1" in
    https://*|http://*) rest="${1#*://}" ;;
    *) die "$1: the home's address starts with https:// (http:// only for a home on the same network)" ;;
  esac
  [[ "$rest" =~ $re ]] || die "$1 is not a home's address: give its origin alone, like https://vsos.colloq.ru (no path, no query, no user)"
}

# The owner's enrollment code (remote-runner.ts · REMOTE_JOIN_CODE): 128 bits,
# 32 hex digits. Never repeated back: it is a key.
check_code() {
  local re='^[a-f0-9]{32}$'
  [[ "$1" =~ $re ]] || die "that is not an enrollment code (32 hex digits): take one from the home's owner, from the panel (Resources → Machines → Connect a machine) or colloq-host runner-code there"
}

check_version() {
  local re='^[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,6}(-[0-9A-Za-z.-]{1,40})?$'
  [[ "$1" =~ $re ]] || die "$1 is neither a version (0.24.0) nor an image (ghcr.io/colloq-edu/colloq-server:0.24.0)"
}

# What runner.left keeps of a join it left with: its hash, never the code.
join_digest() { printf '%s' "$1" | sha256sum | cut -c1-64; }

unset_env_value() {
  ensure_conf
  local tmp
  tmp="$(mktemp "$CONF_DIR/.colloq.env.XXXXXX")"
  grep -v "^$1=" "$ENV_FILE" > "$tmp" || true
  chmod 0600 "$tmp"; mv -f "$tmp" "$ENV_FILE"
}

# The home of this machine, from the join `runner up` wrote.
runner_home() {
  local join; join="$(env_value COLLOQ_RUNNER_JOIN)"
  printf '%s' "${join%%#*}"
}

# The release a home runs, as its /api/health tells anyone who asks: the
# version is in the short answer a stranger gets too, and in a 503 as much as
# in a 200. Through this machine's proxy when it has one; an internal CA,
# which curl takes only instead of its own bundle, only when the plain call
# got nothing.
home_version() {
  local url="$1" body ca proxies
  proxies=("HTTPS_PROXY=$(setting HTTPS_PROXY)" "https_proxy=$(setting https_proxy)" "http_proxy=$(setting http_proxy)"
    "NO_PROXY=$(setting NO_PROXY)" "no_proxy=$(setting no_proxy)")
  body="$(env "${proxies[@]}" curl -sS --max-time 20 "$url/api/health" 2>/dev/null || true)"
  ca="$(setting NODE_EXTRA_CA_CERTS)"
  if [ -z "$body" ] && [ -n "$ca" ] && [ -f "$ca" ]; then
    body="$(env "${proxies[@]}" curl -sS --max-time 20 --cacert "$ca" "$url/api/health" 2>/dev/null || true)"
  fi
  printf '%s' "$body" \
    | sed -nE 's/.*"version"[[:space:]]*:[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)".*/\1/p' | head -1
}

# The home's version as the agent heard it in a sync (homeVersion), for a
# home this host's own curl cannot reach although the agent can: only from a
# sync made at or after SINCE (milliseconds, the moment the update began),
# waited for up to COLLOQ_RUNNER_FRESH_SEC (60: a held sync answers within
# 25 s, a backoff waits at most 30). Never the version the agent kept from
# before. Right after its home moved to another release that is the release
# it left: the home's container is replaced, its tunnel comes back seconds
# later, and meanwhile the agent hears only relay pages and keeps its last
# word. An update that followed it found the machine "already" on it and said
# so, and from its next sync on the machine was «устарела» and took nothing
# (review, 14 Oct 2026). Nothing when no such sync came: the update then asks
# for the version in words rather than guess it.
agent_home_version() {
  local since="$1" bound s at
  bound="$(setting COLLOQ_RUNNER_FRESH_SEC 60)"
  case "$bound" in ''|*[!0-9]*) bound=60 ;; esac
  # A stopped agent syncs with nobody: nothing to wait for.
  [ "$(docker container inspect -f '{{.State.Running}}' "$RUNNER_NAME" 2>/dev/null || true)" = true ] || return 0
  while :; do
    s="$(docker exec "$RUNNER_NAME" colloq-vast runner status 2>/dev/null | grep '^{' | tail -1 || true)"
    at="$(printf '%s' "$s" | sed -nE 's/.*"syncedAt"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -1)"
    if [ -n "$at" ] && [ "$at" -ge "$since" ]; then
      printf '%s' "$s" \
        | sed -nE 's/.*"homeVersion"[[:space:]]*:[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)".*/\1/p' | head -1
      return 0
    fi
    [ "$bound" -ge 2 ] || return 0
    sleep 2; bound=$((bound - 2))
  done
}

# The runner build an image carries (dist/runner.sha256 beside the agent,
# decision 5), read by a throwaway container that runs nothing of the
# image's own: `cat` for its entry point, no network. Nothing when there is
# none. An image from before the machines for submissions (0.22.0 and older)
# has neither the file nor a `runner` mode: its entry point falls through to
# `exec runner`, which exits 127, and under unless-stopped that is a crash
# loop for as long as the machine is up, its image recorded for the reboots.
# A home rolled back to 0.22 (`colloq-host restore --image`, the way back
# `update` prints) names exactly such an image, and an update that followed
# it drained a working agent first (review, 14 Oct 2026).
runner_build_of() {
  docker run --rm --network none --entrypoint cat "$1" /opt/colloq/server/dist/runner.sha256 2>/dev/null \
    | sed -nE 's/^([a-f0-9]{64})([[:space:]].*)?$/\1/p' | head -1 || true
}

# Whether IMG has the agent in it: it is the very image the agent's container
# runs already (started by a colloq-host that asked this, or by the panel's
# join command, which names a release with machines for submissions), or its
# runner build says so. The first spares the `runner up` of every boot a
# throwaway container for an image nothing replaces.
runner_mode_in() {
  local img="$1" id cur
  id="$(docker image inspect -f '{{.Id}}' "$img" 2>/dev/null || true)"
  cur="$(docker container inspect -f '{{.Image}}' "$RUNNER_NAME" 2>/dev/null || true)"
  if [ -n "$id" ] && [ "$id" = "$cur" ]; then return 0; fi
  [ -n "$(runner_build_of "$img")" ]
}

# The repository of an image reference: no tag, no digest, a registry port kept.
image_repo() {
  local ref="${1%@*}"
  case "${ref##*/}" in *:*) ref="${ref%:*}" ;; esac
  printf '%s' "$ref"
}

# The image this machine runs. Named in the call: that one. Otherwise the one
# `runner update` chose last ($RUNNER_IMAGE_FILE), the way /etc/colloq/image
# belongs to `update` for an instance: a reboot must not move a machine to
# another build behind its owner's back. On a first `up`, the published
# colloq-server of the very version the home runs: a machine takes new work
# only while its runner code is the home's (decision 5), and that code is in
# the image of the home's release. COLLOQ_RUNNER_REPO names a registry of
# one's own (a fork, a mirror).
runner_image() {
  local named="$1" url="$2" version
  if [ -n "$named" ]; then printf '%s' "$named"; return 0; fi
  if [ -s "$RUNNER_IMAGE_FILE" ]; then head -1 "$RUNNER_IMAGE_FILE"; return 0; fi
  version="$(home_version "$url")"
  [ -n "$version" ] || die "$url did not say which version it runs (GET $url/api/health): is it up, and can this machine reach it? Or name the image: colloq-host runner up $url <code> ghcr.io/colloq-edu/colloq-server:<version>"
  printf '%s:%s' "$(setting COLLOQ_RUNNER_REPO ghcr.io/colloq-edu/colloq-server)" "$version"
}

# The fingerprint of what the container is made from, as config_sum for the
# instance: a repeated `runner up` (the Vast on-start runs it on every boot)
# with the same image and settings leaves a working machine alone.
#
# The host's network is in it (run_runner): an agent a colloq-host from
# before 0.25 started, on Docker's bridge, carries a sum without that line,
# so the next `runner up` or `runner update` replaces its container with one
# on the host's network, as classes need (remote-classes.md D19), while any
# class containers keep running for the new agent to adopt.
runner_config_sum() {
  { printf '%s\n' "$1"; docker image inspect -f '{{.Id}}' "$1" 2>/dev/null; sort "$ENV_FILE"; printf 'state %s\n' "$RUNNER_STATE"; printf 'network host\n'; config_extras ""; } \
    | sha256sum | cut -c1-16
}

# What the agent's container is given to see, into RUNNER_MOUNTS: the socket
# (every submission runs in a container of its own on this Docker), the tree
# at the same path on both sides (entrypoint.sh · require_same_path), the
# registry credentials as for the instance (the agent's docker pulls the
# kernels by digest, from a private registry too), and an internal CA bundle
# at the path NODE_EXTRA_CA_CERTS names, which Node reads only at start.
#
# One list for the agent and for the one-off container a stopped machine
# leaves from (runner_leave): that one was told NODE_EXTRA_CA_CERTS by the
# settings file without the file itself, so Node started without the CA, and
# a leave to a campus home behind that CA (or a TLS-inspecting proxy) failed
# as "transient" for the one-off's ten minutes, ending with "revoke it on the
# home" for a machine that only wanted to leave (review, 14 Oct 2026).
RUNNER_MOUNTS=()
runner_mounts() {
  local ca
  RUNNER_MOUNTS=(-v /var/run/docker.sock:/var/run/docker.sock -v "$RUNNER_STATE:$RUNNER_STATE")
  if [ -s /root/.docker/config.json ]; then
    RUNNER_MOUNTS+=(-v /root/.docker/config.json:/run/colloq/docker-config.json:ro)
  fi
  ca="$(env_value NODE_EXTRA_CA_CERTS)"
  if [ -n "$ca" ]; then
    if [ -f "$ca" ]; then RUNNER_MOUNTS+=(-v "$ca:$ca:ro")
    else warn "NODE_EXTRA_CA_CERTS=$ca is not a file on this machine; the container gets the path as it is"
    fi
  fi
}

# The agent's container. No port: it only ever calls out (the home, the
# registry, the package index). What it sees is runner_mounts' list.
#
# Its health is the image's own check, which knows the mode it was started in
# (entrypoint.sh · health): the agent's answer to "joined and syncing" here,
# so that `docker ps` tells the truth on a machine joined by the panel's plain
# `docker run` too. Only the pace is set here: the answer is a node process
# rather than a curl, and a machine is in no hurry.
#
# Two words the agent uses for itself. COLLOQ_RUNNER_IMAGE is the image it
# runs, the one it probes the cards with: `--gpus all` puts nvidia-smi into
# any container, and this one is on the machine for certain, where a CUDA
# image would be a pull of gigabytes to count the cards. COLLOQ_RUNNER_CONTAINER
# is this container, whose restart policy the agent turns off before it
# stops on a 401: a machine its owner revoked must not be started again by
# Docker's unless-stopped into a home that refuses it, every few seconds, for
# as long as the VM is up.
#
# A minute and a half to stop (--stop-timeout, stop_runner): on SIGTERM the
# agent hands back what it holds, a `draining` decline per run, and those
# calls go out like any other. Through a relay that is restarting they wait
# out the agent's backoff, up to 30 s a try (REMOTE_BACKOFF_MAX_MS), and half
# a minute was one try.
#
# On the host's network (--network host, D19), and that is for the classes:
# a class kernel's Jupyter is published on the host's 127.0.0.1 alone
# (room-spec.ts · machineRoomRunArgs), which an agent on Docker's bridge
# cannot reach and a rented VM's public address never sees. The agent still
# opens no port of its own. Under host networking a container's hostname is
# the host's, which no container is called by, so the entry point is told
# the name it finds its own container by (COLLOQ_CONTAINER, locate_self):
# the image's own entry point finds it without, an older one would not.
run_runner() {
  local img="$1" sum
  sum="$(runner_config_sum "$img")"
  if docker container inspect "$RUNNER_NAME" >/dev/null 2>&1; then
    if [ "$(docker inspect -f '{{index .Config.Labels "colloq.config"}}' "$RUNNER_NAME")" = "$sum" ]; then
      docker start "$RUNNER_NAME" >/dev/null 2>&1 || true
      say "$RUNNER_NAME is already running with these settings"
      return 0
    fi
    say "replacing $RUNNER_NAME (new image or settings); class kernels keep running"
    stop_runner
    docker rm "$RUNNER_NAME" >/dev/null
  fi
  mkdir -p "$RUNNER_STATE"
  runner_mounts
  docker run -d --name "$RUNNER_NAME" \
    --restart unless-stopped \
    --network host \
    --stop-timeout 90 \
    --log-opt max-size=50m --log-opt max-file=5 \
    --health-interval 30s --health-timeout 20s --health-start-period 120s --health-retries 3 \
    "${RUNNER_MOUNTS[@]}" \
    --env-file "$ENV_FILE" \
    -e "COLLOQ_RUNNER_STATE=$RUNNER_STATE" \
    -e "COLLOQ_RUNNER_IMAGE=$img" \
    -e "COLLOQ_RUNNER_CONTAINER=$RUNNER_NAME" \
    -e "COLLOQ_CONTAINER=$RUNNER_NAME" \
    --label colloq.kind=runner --label "colloq.config=$sum" \
    "$img" runner >/dev/null
  say "started $RUNNER_NAME from $img"
}

# Joined and syncing, which `runner status` answers 0 for: seconds after a
# start. The kernels and the data come after, in the background, and are the
# home's panel to show («образ ↓ 45 %»).
wait_joined() {
  local url="$1" wait tries _
  wait="$(setting COLLOQ_RUNNER_JOIN_WAIT 180)"
  case "$wait" in ''|*[!0-9]*) wait=180 ;; esac
  tries=$(( (wait + 1) / 2 )); [ "$tries" -ge 1 ] || tries=1
  for _ in $(seq 1 "$tries"); do
    if docker exec "$RUNNER_NAME" colloq-vast runner status >/dev/null 2>&1; then
      say "$RUNNER_NAME has joined ${url:-its home}, which now lists it among its machines for submissions"
      say "it pulls the kernels and the data it is asked for in the background; watch: colloq-host runner status | logs"
      return 0
    fi
    [ "$(docker inspect -f '{{.State.Running}}' "$RUNNER_NAME" 2>/dev/null || true)" = true ] || break
    sleep 2
  done
  docker logs --tail 60 "$RUNNER_NAME" >&2 || true
  if [ "$(docker inspect -f '{{.State.Running}}' "$RUNNER_NAME" 2>/dev/null || true)" = true ]; then
    die "$RUNNER_NAME has not joined ${url:-its home} in $wait s, and keeps trying; the log is above (colloq-host runner logs)"
  fi
  die "$RUNNER_NAME stopped before it joined ${url:-its home}; the log is above"
}

# WHAT A MACHINE FOR CLASSES NEEDS (`runner up --classes`), each problem on
# a line of its own, for the person who can change it; nothing when the
# machine will do. The home asks its agent the same once it runs, names in
# its panel what is missing and places no class here until it holds; this is
# the same answer before anything is pulled, and before the code's use is
# spent on a machine that cannot have it.
#
#   - Docker run by root, with its iptables: the network of a class is fenced
#     by rules hooked into DOCKER-USER (perimeter-core.ts), which a rootless
#     daemon, one with "iptables": false and one on the nftables backend do
#     not have; the home's helper exits 20 or 21 on them;
#   - cgroup v2: what a kernel used, and why it died, are read from its
#     cgroup v2 files (postmortem-core.ts · CGROUP_SCRIPT);
#   - no Colloq server on this Docker (D20): a home's census and sweeps
#     would meet the class containers, and its rooms and the classes would
#     share cards and memory that nobody counts for both. Asked as the agent
#     asks it (runner-agent/kernels.ts · detectSameDaemon): the server's
#     container, its rooms, or its rooms' network, which stays when every
#     room has gone idle and its container with it (kernel/pool.ts removes
#     a stopped room's), as on a pip or `make dev` home between classes;
#   - the disk of the agent's tree: a machine's floor (REMOTE_DISK_MIN_GB,
#     40 GB without cards and 120 with) and CLASS_DISK_GB more for the class
#     folders, which hold up to a room's limit each (1 GB by default) and
#     what stays on the machine besides: files over the cap, package trees.
#     5 % short of it still passes: a disk rented at a size shows a few
#     percent less in df (runner-agent/sync.ts · DISK_SLACK).
CLASS_DISK_GB=20
classes_problems() {
  local options cgroup probe="$RUNNER_STATE" total_kb need_gb kind=without
  options="$(docker info --format '{{json .SecurityOptions}}' 2>/dev/null || true)"
  case "$options" in
    *rootless*) printf '%s\n' "Docker here runs rootless: classes need the daemon run by root, whose iptables rules fence the network of every class" ;;
  esac
  # The chain Docker makes for its users' rules, looked for with the host's own
  # iptables (no iptables at all reads the same: Docker manages none here).
  iptables -w -n -L DOCKER-USER >/dev/null 2>&1 \
    || printf '%s\n' "Docker here does not manage iptables (no DOCKER-USER chain: \"iptables\": false in /etc/docker/daemon.json, its nftables backend, or no iptables at all): classes need those rules to fence the network of every class"
  cgroup="$(docker info --format '{{.CgroupVersion}}' 2>/dev/null || true)"
  [ "$cgroup" = 2 ] \
    || printf '%s\n' "this machine runs cgroup ${cgroup:-of no known version}, and classes need cgroup v2 (the default since Ubuntu 21.10 and Debian 11): what a kernel used, and why it died, are read from it"
  if docker container inspect "$NAME" >/dev/null 2>&1 \
    || [ -n "$(docker ps -aq --filter label=colloq.kind=app 2>/dev/null || true)" ] \
    || [ -n "$(docker ps -aq --filter label=colloq.kind=room-kernel 2>/dev/null || true)" ] \
    || [ -n "$(docker network ls -q --filter label=colloq.kind=room-network 2>/dev/null || true)" ]; then
    printf '%s\n' "a Colloq server runs on this Docker (its container, its rooms, or its rooms' network): a machine that takes classes needs a Docker of its own, apart from any home's rooms"
  fi
  while [ ! -d "$probe" ] && [ "$probe" != / ]; do probe="$(dirname "$probe")"; done
  total_kb="$(df -Pk "$probe" 2>/dev/null | awk 'NR == 2 { print $2 }' || true)"
  need_gb=40
  if command -v nvidia-smi >/dev/null 2>&1; then need_gb=120; kind=with; fi
  case "$total_kb" in
    ''|*[!0-9]*) ;;
    *)
      if [ "$total_kb" -lt $(((need_gb + CLASS_DISK_GB) * 1048576 * 95 / 100)) ]; then
        printf '%s\n' "the disk of $RUNNER_STATE holds $((total_kb / 1048576)) GB, and a machine $kind cards that takes classes needs $((need_gb + CLASS_DISK_GB)) GB: the $need_gb GB any machine $kind cards needs, and $CLASS_DISK_GB GB for the class folders"
      fi ;;
  esac
}

# The label of this tree's agent, on every container it starts
# (runner-agent/images.ts · INSTANCE_LABEL): the first sixteen hex digits of
# the sha256 of its data root, <tree>/data, as the entry point hands it the
# path (DATA_DIR), a plain one here as there (runner_state_problem).
# tests/vast-runner-host.test.mts holds the two equal.
instance_label() {
  printf 'ru.colloq.competition-instance=%s' "$(printf '%s' "$RUNNER_STATE/data" | sha256sum | cut -c1-16)"
}

# The classes this machine holds now: their kernels' containers on this
# Docker (colloq.kind=class-kernel), counted by class from the placement
# label each carries, `colloq.placement=<id>:<role>:<gen>` (room-spec.ts): a
# class's room, personal and council containers are one class. A stopped one
# counts too: its home still has the class placed here. This tree's agent's
# alone, by its label beside the kind, as the agent adopts them
# (runner-agent/kernels.ts · listed): two agents on one Docker (two trees on
# a university's server, make runner-dev beside a machine's own) each hold
# their own classes, and the leave or update of one is no question about
# the other's.
class_count() {
  docker ps -a --filter label=colloq.kind=class-kernel --filter "label=$(instance_label)" --format '{{.Label "colloq.placement"}}' 2>/dev/null \
    | sed -nE 's/^([A-Za-z0-9_-]{1,64}):(room|own|council):[0-9]+$/\1/p' | sort -u | grep -c . || true
}

runner_up() {
  need_root
  local url="" code="" named="" img join from_home=0 classes=0 arg words=0 problems line
  for arg in "$@"; do
    case "$arg" in
      --classes) classes=1 ;;
      -*) die "usage: colloq-host runner up https://<home> <code> [IMAGE] [--classes]" ;;
      *)
        words=$((words + 1))
        case "$words" in 1) url="$arg" ;; 2) code="$arg" ;; 3) named="$arg" ;; *) die "usage: colloq-host runner up https://<home> <code> [IMAGE] [--classes]" ;; esac ;;
    esac
  done
  [ -n "$url" ] && [ -n "$code" ] \
    || die "usage: colloq-host runner up https://<home> <code> [IMAGE] [--classes]   (the code comes from the home's owner: the panel, Resources → Machines → Connect a machine, or colloq-host runner-code there)"
  url="${url%/}"
  check_home "$url"
  check_code "$code"
  join="$url#$code"
  # A code may keep uses for other machines after this one leaves with it, and
  # the Vast on-start says this very `runner up` on every boot: a machine that
  # left must not come back on its old code.
  if [ -f "$RUNNER_LEFT_FILE" ] && grep -qxF "$(join_digest "$join")" "$RUNNER_LEFT_FILE"; then
    die "this machine left $url with this code (colloq-host runner leave); a new code from the home's owner joins it again"
  fi
  if on_vast; then export COLLOQ_ON_VAST=1; fi
  freeze_host_updates
  ensure_docker
  # A machine for classes is checked before anything is written, pulled or
  # started (classes_problems), and every problem found is named at once.
  if [ "$classes" = 1 ]; then
    problems="$(classes_problems)"
    if [ -n "$problems" ]; then
      while IFS= read -r line; do printf '[colloq-host] ERROR: %s\n' "$line" >&2; done <<EOF
$problems
EOF
      die "this machine cannot take classes (above), and nothing was pulled or started: fix what is said and run this again, or join it for submissions only with a code that takes no classes"
    fi
    say "this machine can take classes: Docker run by root with its iptables, cgroup v2, no Colloq server on this Docker, disk enough for the class folders"
  fi
  # Said, not refused: the owner may be trying the agent out on a spare
  # instance. But a class here would find its cards shared out to submissions
  # and its memory counted for them (the header says why).
  if docker container inspect "$NAME" >/dev/null 2>&1; then
    warn "this machine runs an instance too ($NAME): the agent shares out every card here and admits submissions by the whole machine's memory, knowing nothing of its rooms; give the submissions a machine of their own"
  fi
  write_env
  set_env_value COLLOQ_RUNNER_JOIN "$join"
  ensure_gpu runner
  # Whether the image comes from the home's version (runner_image), for the
  # words of a refusal below.
  [ -n "$named" ] || [ -s "$RUNNER_IMAGE_FILE" ] || from_home=1
  img="$(runner_image "$named" "$url")"
  registry_login "$img"
  fetch_image "$img"
  # The agent must be in it before the image is recorded and anything is
  # started or replaced (runner_build_of says why): a home rolled back to a
  # release from before the machines names one without, and the Vast
  # on-start would say this very `runner up` again on every boot.
  if ! runner_mode_in "$img"; then
    [ "$from_home" = 0 ] \
      || die "$url runs ${img##*:}, a release from before machines for submissions: $img has no runner mode, and nothing was started. Join it once the home runs a release with them"
    die "$img has no machines for submissions in it (no runner mode: a release from before them, or not a colloq-server image); nothing was started"
  fi
  mkdir -p "$CONF_DIR"; printf '%s\n' "$img" > "$RUNNER_IMAGE_FILE"
  run_runner "$img"
  wait_joined "$url"
}

# A MACHINE JOINED BY HAND. The panel's first join command (§8.1 of the
# design) is a plain `docker run` of the image: such a machine has its
# container and nothing else, no runner.env, no runner-image, perhaps no
# /etc/colloq at all, and its settings are in the container. So before update
# and leave act, and when status or logs look, they are read out of it: the
# image it runs, the join and the tree in its environment (or the join in its
# command, `runner join URL CODE`), the mount its tree comes from. They go
# where colloq-host keeps its own, and from then on the machine is managed as
# if `runner up` had started it. Of the rest of its environment only
# RUNNER_KEYS come along: everything else there is the image's own ENV, which
# the next container gets from its image anyway. A container colloq-host
# started (its colloq.config label) whose two files are in place is left
# alone; one whose files went missing gets them back the same way.
#
# The mounts decide whether the old agent can be replaced at all. Its tree
# must come from the host at the same path, as the entry point demands
# (require_same_path: a machine whose tree is mounted otherwise never started
# its agent). The socket, a CA bundle at the path NODE_EXTRA_CA_CERTS names
# and the registry credentials are given again by run_runner. Anything else
# would be lost with the old container, so an update refuses before it drains
# (ADOPT_EXTRA, runner_inputs_ready); leave, status and logs do not need it.
#
# `strict` (update, leave) refuses what it cannot take over; `quiet` (status,
# logs) says so and goes on, since a look must not fail for it. Its words go
# to stderr: status prints the agent's JSON on stdout, and scripts read it.
ADOPT_EXTRA=""
adopt_runner() {
  local how="$1" label img line key value join="" state="" ca="" dest src best="" host="" extra="" problem kv
  local c0="" c1="" c2="" c3="" kept=() keys
  docker container inspect "$RUNNER_NAME" >/dev/null 2>&1 || return 0
  label="$(docker container inspect -f '{{index .Config.Labels "colloq.config"}}' "$RUNNER_NAME" 2>/dev/null || true)"
  if [ -n "$label" ] && [ -f "$RUNNER_ENV_FILE" ] && [ -s "$RUNNER_IMAGE_FILE" ]; then return 0; fi
  img="$(docker container inspect -f '{{.Config.Image}}' "$RUNNER_NAME" 2>/dev/null || true)"
  keys=" $(printf '%s' "$RUNNER_KEYS" | tr '\n' ' ') "
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    [ "$key" != "$line" ] || continue
    case "$key" in
      COLLOQ_RUNNER_JOIN) join="$value" ;;
      COLLOQ_RUNNER_STATE) state="$value" ;;
      NODE_EXTRA_CA_CERTS) ca="$value" ;;
    esac
    case "$keys" in *" $key "*) kept+=("$key=$value") ;; esac
  done < <(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$RUNNER_NAME" 2>/dev/null || true)
  if [ -z "$join" ]; then
    { IFS= read -r c0 || true; IFS= read -r c1 || true; IFS= read -r c2 || true; IFS= read -r c3 || true; } \
      < <(docker container inspect -f '{{range .Config.Cmd}}{{println .}}{{end}}' "$RUNNER_NAME" 2>/dev/null || true)
    if [ "$c0" = runner ] && [ "$c1" = join ] && [ -n "$c2" ] && [ -n "$c3" ]; then join="${c2%/}#$c3"; fi
  fi
  # The entry point's default when the container names none.
  state="${state:-/var/lib/colloq-runner}"
  [ "$state" = / ] || state="${state%/}"
  problem="$(runner_state_problem "$state" "$STATE")"
  if [ -z "$problem" ]; then
    while IFS=$'\t' read -r dest src; do
      [ -n "$dest" ] || continue
      # The tree, or a directory above it mounted whole: the longest one counts,
      # as in the entry point (host_path_of).
      if [ "$state" = "$dest" ] || [ "${state#"$dest"/}" != "$state" ]; then
        if [ "${#dest}" -gt "${#best}" ]; then best="$dest"; host="${src}${state#"$dest"}"; fi
        continue
      fi
      case "$dest" in /var/run/docker.sock|/run/colloq/docker-config.json) continue ;; esac
      if [ -n "$ca" ] && [ "$dest" = "$ca" ]; then continue; fi
      extra="${extra:+$extra, }$dest (from $src)"
    done < <(docker container inspect -f '{{range .Mounts}}{{.Destination}}{{"\t"}}{{.Source}}{{"\n"}}{{end}}' "$RUNNER_NAME" 2>/dev/null || true)
    if [ -z "$best" ]; then problem="its tree $state is not mounted from this machine, so its agent never started (the entry point refuses that)"
    elif [ "$host" != "$state" ]; then problem="its tree $state is mounted from $host, so its agent never started (the entry point wants the same path on both sides)"
    elif [ -z "$img" ]; then problem="docker does not say which image it runs"
    fi
  fi
  if [ -n "$problem" ]; then
    if [ "$how" = strict ]; then
      die "$RUNNER_NAME was not started by colloq-host, and cannot be taken over: $problem. Nothing was changed; revoke it on the home (Resources → Machines) and remove it (docker rm -f $RUNNER_NAME), or join again with colloq-host runner up"
    fi
    warn "$RUNNER_NAME was not started by colloq-host, and is not taken over: $problem"
    return 0
  fi
  if [ -n "${COLLOQ_RUNNER_STATE:-}" ] && [ "${COLLOQ_RUNNER_STATE%/}" != "$state" ]; then
    warn "COLLOQ_RUNNER_STATE=$COLLOQ_RUNNER_STATE is not the tree $RUNNER_NAME runs on; it keeps its own, $state"
  fi
  ensure_conf
  for kv in ${kept[@]+"${kept[@]}"}; do set_env_value "${kv%%=*}" "${kv#*=}"; done
  [ -z "$join" ] || set_env_value COLLOQ_RUNNER_JOIN "$join"
  set_env_value COLLOQ_RUNNER_STATE "$state"
  printf '%s\n' "$img" > "$RUNNER_IMAGE_FILE"
  RUNNER_STATE="$state"
  ADOPT_EXTRA="$extra"
  say "$RUNNER_NAME was started without colloq-host: its settings are now in $RUNNER_ENV_FILE and its image ($img) in $RUNNER_IMAGE_FILE" >&2
}

# What the agent's status says of its classes, in a person's words: its
# tunnel to the home, up or down with its round trip, and the class
# containers it holds by role, as an agent of 0.25 and later reports them
# (runner-agent/main.ts · status: `"tunnel":{"up":true,"rttMs":48}` or null
# while its home asks for none, `"classes":{"room":1,"own":1,"council":0}`;
# a tunnel given as the word "up" or "down" reads the same). Nothing for an
# agent from before classes, nor for one with no tunnel and no class, which
# is every machine that takes none.
status_classes() {
  local s="$1" tunnel up rtt counts room own council
  tunnel="$(printf '%s' "$s" | sed -nE 's/.*"tunnel"[[:space:]]*:[[:space:]]*(\{[^}]*\}|"[a-z]+").*/\1/p' | head -1)"
  if [ -n "$tunnel" ]; then
    case "$tunnel" in
      '"up"'|*'"up":true'*|*'"up": true'*|*'"state":"up"'*) up=up ;;
      *) up=down ;;
    esac
    rtt="$(printf '%s' "$tunnel" | sed -nE 's/.*"rttMs"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -1)"
    say "tunnel: $up${rtt:+ · RTT $rtt ms}"
  fi
  counts="$(printf '%s' "$s" | sed -nE 's/.*"classes"[[:space:]]*:[[:space:]]*(\{[^}]*\}).*/\1/p' | head -1)"
  [ -n "$counts" ] || return 0
  room="$(printf '%s' "$counts" | sed -nE 's/.*"room"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p')"
  own="$(printf '%s' "$counts" | sed -nE 's/.*"own"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p')"
  council="$(printf '%s' "$counts" | sed -nE 's/.*"council"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p')"
  if [ -n "$tunnel" ] || [ "${room:-0}${own:-0}${council:-0}" != 000 ]; then
    say "classes: room ${room:-0} · own ${own:-0} · council ${council:-0}"
  fi
}

runner_status() {
  need_root
  local line rc=0 network
  if ! docker container inspect "$RUNNER_NAME" >/dev/null 2>&1; then
    say "there is no $RUNNER_NAME on this machine: colloq-host runner up https://<home> <code>"
    exit 1
  fi
  adopt_runner quiet
  if [ "$(docker container inspect -f '{{.State.Running}}' "$RUNNER_NAME" 2>/dev/null || true)" != true ]; then
    say "$RUNNER_NAME is not running ($(docker container inspect -f '{{.State.Status}}' "$RUNNER_NAME" 2>/dev/null || true)); why: colloq-host runner logs"
    exit 1
  fi
  # The agent's line alone on stdout, as scripts read it; the words about it on stderr.
  line="$(docker exec "$RUNNER_NAME" colloq-vast runner status)" || rc=$?
  [ -z "$line" ] || printf '%s\n' "$line"
  status_classes "$line" >&2
  # An agent that can hold classes (one that reports them, 0.25 and later)
  # in a container off the host's network holds none (D19): a colloq-host
  # from before 0.25 started it, or the panel's command of then. That is what
  # the first update of a machine to 0.25 leaves, since the colloq-host of
  # before runs it and installs this one only at its end; the next update,
  # this colloq-host's, moves the agent (its fingerprint counts the network).
  network="$(docker container inspect -f '{{.HostConfig.NetworkMode}}' "$RUNNER_NAME" 2>/dev/null || true)"
  case "$line" in
    *'"classes"'*)
      [ -z "$network" ] || [ "$network" = host ] \
        || warn "$RUNNER_NAME runs on Docker's network ($network), not the host's, as a colloq-host from before 0.25 starts it: it takes submissions, and no classes until colloq-host runner update moves it onto the host's network" ;;
  esac
  exit "$rc"
}

# The update a class does not notice: the agent takes no new leases, finishes
# the runs it holds and uploads their answers, and only then is the container
# replaced. `runner drain` returns once nothing is held, bounded by the
# longest any run can last: the ceiling of the longest wall
# (remote-runner.ts · REMOTE_RUN_MS_MAX, 15,720 s).
#
# Stopping the container is the other way, the one --now takes and the one a
# reboot takes: SIGTERM, on which the agent hands back what it holds (a
# `draining` decline, which the home requeues counting no loss and spending
# no attempt) and exits, with a minute and a half to say so before Docker
# kills it (run_runner says why so long). So the stop that ends a drain hands
# back nothing, and one that ends a drain cut short hands back only what was
# still running.
#
# AND A STOP HERE IS A RESTART: an update, a replacement for new settings.
# The marker in the tree (<state>/restart.marker) makes the sync the agent
# says goodbye with say `bye: restart` instead of `stopping`, and its home
# then holds off moving the classes here to the server for two minutes,
# while the new agent comes up and adopts their containers with their
# variables (remote-classes.md §11.4, D23). Written only for an agent that
# runs (a stopped one says nothing more), and removed after the stop whether
# it was read or not: one left behind would make the next stop that is an
# end, a leave's or a `docker stop` by hand, read as a restart and hold the
# classes' move for nothing.
stop_runner() {
  local marker="$RUNNER_STATE/restart.marker"
  if [ "$(docker container inspect -f '{{.State.Running}}' "$RUNNER_NAME" 2>/dev/null || true)" = true ]; then
    { printf 'colloq-host %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$marker"; } 2>/dev/null \
      || warn "could not write $marker: the agent says goodbye as stopping, and its home moves any classes here to the server if the new agent is not back within a minute"
  fi
  docker stop -t 90 "$RUNNER_NAME" >/dev/null 2>&1 || true
  rm -f "$marker"
}

# Seconds as a person reads them: minutes from two of them on.
span() { if [ "$1" -ge 120 ]; then printf '%s min' "$(( $1 / 60 ))"; else printf '%s s' "$1"; fi; }

drain_runner() {
  local bound rc=0
  bound="$(setting COLLOQ_RUNNER_DRAIN_SEC 15720)"
  case "$bound" in ''|*[!0-9]*) die "COLLOQ_RUNNER_DRAIN_SEC=$bound is not a number of seconds" ;; esac
  say "draining $RUNNER_NAME: it finishes the runs it holds and takes no new ones (at most $((bound / 60)) min; --now does not wait)"
  with_timeout "$bound" docker exec "$RUNNER_NAME" colloq-vast runner drain || rc=$?
  case "$rc" in
    0) ;;
    124) warn "$RUNNER_NAME still holds runs after $((bound / 60)) min; stopping it hands them back to the home's queue" ;;
    *) warn "$RUNNER_NAME did not drain on request (above); stopping it hands its runs back to the home's queue" ;;
  esac
  stop_runner
}

# Everything the new container is made of, checked while the old agent still
# runs. Once it has been drained and stopped, a piece found missing would
# leave the machine with no agent at all and its home a machine short until
# somebody looks, so each refusal here comes before the drain and changes
# nothing: the image is here, the settings file and its directory exist (the
# image file is written after the stop), the tree with the machine's identity
# is where the settings say, the CA bundle the agent needs to reach its home
# is a file, and nothing the old container mounted would be left behind.
runner_inputs_ready() {
  local img="$1" ca
  docker image inspect "$img" >/dev/null 2>&1 || die "$img is not on this machine; nothing was changed"
  { [ -d "$CONF_DIR" ] && [ -f "$ENV_FILE" ]; } || die "there is no $ENV_FILE to start the new agent with; nothing was changed"
  [ -d "$RUNNER_STATE" ] \
    || die "$RUNNER_STATE, the tree that holds this machine's identity, is not on this machine; nothing was changed (COLLOQ_RUNNER_STATE in $ENV_FILE names it)"
  ca="$(env_value NODE_EXTRA_CA_CERTS)"
  [ -z "$ca" ] || [ -f "$ca" ] \
    || die "NODE_EXTRA_CA_CERTS=$ca is not a file on this machine, and the new agent would not reach its home without it; nothing was changed"
  [ -z "$ADOPT_EXTRA" ] \
    || die "$RUNNER_NAME also mounts $ADOPT_EXTRA, which colloq-host does not give the agent, and it would be gone with the old container; nothing was changed. Recreate it without, or join again with colloq-host runner up"
}

# The tunnel protocol an image's agent speaks (shared/remote-tunnel.ts ·
# TUNNEL_PROTOCOL), as its entry point states it, read the way its runner
# build is (runner_build_of): a throwaway container that runs nothing of the
# image's own. Nothing for an image from before classes on machines (0.24.0
# and older), whose agent dials no tunnel at all.
tunnel_protocol_of() {
  docker run --rm --network none --entrypoint cat "$1" /usr/local/bin/colloq-vast 2>/dev/null \
    | sed -nE 's/^TUNNEL_PROTOCOL=([0-9]+)$/\1/p' | head -1 || true
}

# THE TUNNEL MOVES ONLY WITH ITS HOME. While classes run here, their kernels
# are reached through the agent's tunnel, which the home takes in its own
# protocol only (another is refused with 4426). The agent running now speaks
# the home's, or its classes would have moved off already; a new one of
# another protocol finds no tunnel, and its classes move to the server two
# minutes later, their variables lost. So an update that changes the
# protocol under live classes is refused before anything is drained or
# stopped, unless the new image is the very release the home runs: that is
# the update the documented order makes (the home first, then its machines),
# and the one that brings the agent back to its home's protocol. Another
# runner build in the same protocol is no such update: the home takes the
# tunnel of a machine outdated or not, for the placements it holds, and
# holds back only new ones from it (kernel/remote/tunnel.ts, remote-classes.md
# §15), so an update to another release keeps its classes running.
tunnel_follows_home() {
  local img="$1" cur="$2" classes="$3" home="$4" since="$5" new old release url
  new="$(tunnel_protocol_of "$img")"
  old="$(tunnel_protocol_of "$cur")"
  [ "$new" != "$old" ] || return 0
  release="$(image_label "$img" org.opencontainers.image.version)"
  if [ -z "$home" ]; then
    url="$(runner_home)"
    [ -z "$url" ] || home="$(home_version "$url")"
    [ -n "$home" ] || home="$(agent_home_version "$since")"
  fi
  if [ -n "$release" ] && [ "$release" = "$home" ]; then return 0; fi
  die "this machine holds $classes class(es), reached through its agent's tunnel in protocol ${old:-none}, its home's, and the agent of $img speaks ${new:-none}: its home would refuse that tunnel, and the classes would move to the server, their variables lost. Nothing was changed: update to the release the home runs (${home:-not known here}: colloq-host runner update), or once the classes are over"
}

runner_update() {
  need_root
  local want="" now=0 arg cur img version url new_id cur_id sum since classes
  # The agent's word on its home's version counts only from a sync made from
  # now on (agent_home_version says why).
  since="$(date +%s)000"
  for arg in "$@"; do
    case "$arg" in
      --now) now=1 ;;
      -*) die "usage: colloq-host runner update [VERSION|IMAGE] [--now]" ;;
      *) [ -z "$want" ] || die "usage: colloq-host runner update [VERSION|IMAGE] [--now]"; want="$arg" ;;
    esac
  done
  docker container inspect "$RUNNER_NAME" >/dev/null 2>&1 \
    || die "there is no $RUNNER_NAME on this machine: colloq-host runner up https://<home> <code>"
  adopt_runner strict
  cur="$(head -1 "$RUNNER_IMAGE_FILE" 2>/dev/null || true)"
  [ -n "$cur" ] || cur="$(docker container inspect -f '{{.Config.Image}}' "$RUNNER_NAME")"
  case "$want" in
    '')
      # The home's version: what makes a machine «устарел» is the home moving on.
      url="$(runner_home)"; version=""
      [ -z "$url" ] || version="$(home_version "$url")"
      [ -n "$version" ] || version="$(agent_home_version "$since")"
      [ -n "$version" ] || die "neither ${url:-the home} nor the agent says which version the home runs (the agent's word counts from a sync since this update began, and none came: is the home up?); name it: colloq-host runner update <version>"
      img="$(image_repo "$cur"):$version" ;;
    */*|*:*|*@*) img="$want" ;;
    *) check_version "$want"; img="$(image_repo "$cur"):$want" ;;
  esac
  # The new image first: a pull that fails must not have cost the machine its runs.
  registry_login "$img"
  fetch_image "$img"
  new_id="$(docker image inspect -f '{{.Id}}' "$img")"
  cur_id="$(docker container inspect -f '{{.Image}}' "$RUNNER_NAME" 2>/dev/null || true)"
  sum="$(runner_config_sum "$img")"
  if [ "$cur_id" = "$new_id" ] && [ "$(docker container inspect -f '{{index .Config.Labels "colloq.config"}}' "$RUNNER_NAME" 2>/dev/null || true)" = "$sum" ]; then
    printf '%s\n' "$img" > "$RUNNER_IMAGE_FILE"
    docker start "$RUNNER_NAME" >/dev/null 2>&1 || true
    say "$RUNNER_NAME already runs $img"
    return 0
  fi
  # The same image under other settings (runner.env edited, or a container
  # colloq-host did not start) is a replacement all the same, and goes the
  # same way: a container is never swapped under a running agent undrained.
  [ "$cur_id" != "$new_id" ] || say "$RUNNER_NAME runs $img already, but not with these settings: it is replaced the same way"
  runner_inputs_ready "$img"
  # The agent must be in the new image, and that too is known before the old
  # one is drained (runner_build_of says why): the home's version after a
  # rollback, or a VERSION= named by mistake, would otherwise leave the
  # machine a crash loop where a working agent was.
  if ! runner_mode_in "$img"; then
    [ -n "$want" ] \
      || die "the home runs $version, a release from before machines for submissions: $img has no runner mode. Nothing was changed: $RUNNER_NAME keeps running $cur, idle until the home runs a release with them again (then colloq-host runner update, should that release's runner build be another)"
    die "$img has no machines for submissions in it (no runner mode: a release from before them, or not a colloq-server image); nothing was changed: $RUNNER_NAME keeps running $cur"
  fi
  # Classes keep running across the update: the new agent adopts their
  # containers, and its home holds them for the restart (stop_runner). Only
  # an agent its home would not let back onto the tunnel is refused.
  classes="$(class_count)"
  [ "$classes" = 0 ] || tunnel_follows_home "$img" "$cur_id" "$classes" "$version" "$since"
  if [ "$(docker container inspect -f '{{.State.Running}}' "$RUNNER_NAME" 2>/dev/null || true)" = true ]; then
    if [ "$now" = 1 ]; then
      say "stopping $RUNNER_NAME now (--now): the runs it holds go back to the home's queue and run again, spending no participant's attempts"
      stop_runner
    else
      drain_runner
    fi
  fi
  printf '%s\n' "$img" > "$RUNNER_IMAGE_FILE"
  run_runner "$img"
  wait_joined "$(runner_home)"
  # The manager moves with the image it manages, as in update.
  if [ -w "$HOST_BIN" ] && docker run --rm -v "$HOST_BIN:/host" "$img" install-host /host >/dev/null 2>&1; then
    say "colloq-host itself updated from $img"
  else
    warn "colloq-host itself is still the one from before; the new one: docker run --rm -v $HOST_BIN:/host $img install-host /host"
  fi
}

# The identity the machine left with (runner.json: its id and its secret) is
# revoked on the home from now on. Left in the tree, it would greet the next
# join: a `runner up` with a new code would start an agent that calls its home
# as the machine it was, and hears 401 for good. So it is put aside, under a
# name no agent reads, and the caches (kernels, data, wheels) stay for the
# next join to use.
retire_identity() {
  local id="$RUNNER_STATE/runner.json" kept
  [ -f "$id" ] || return 0
  kept="$id.left-$(date -u +%Y%m%dT%H%M%SZ)"
  mv -f "$id" "$kept"
  say "its revoked identity is put aside as $kept; a new join starts without it"
}

# The leave of a running agent, waited for within bounds. It ends with the
# home's answer to the agent's `leaving` sync, once the runs it holds have
# finished: hours at most for the runs (the drain's bound), and never while
# the home does not answer. A home destroyed before its machines, or one cut
# off (the data centre of 8 Oct), kept `make runners-down` waiting on every
# machine for good, each billing by the hour, the ssh kept alive by its
# keepalives and nothing on the screen saying what it waited for (review, 14
# Oct 2026). So the wait gives up once the agent has heard nothing from its
# home for SILENT seconds, counted from its last good sync or from the
# leave's start, whichever is later, and in any case after BOUND seconds.
# The agent's own status file in the tree says when it last heard its home
# (what `runner status` prints); it is read every second, a file rather than
# a docker exec, since a leave with nothing held is over in a round trip.
# Giving up ends only the waiting: the agent goes on leaving (it takes no new
# work, and revokes itself once its home answers). Returns the leave's own
# exit code; 124 past BOUND, 125 for the silence.
leave_running_agent() {
  local bound="$1" silent="$2" began now heard at pid rc=0
  began="$(date +%s)"
  docker exec "$RUNNER_NAME" colloq-vast runner leave &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    now="$(date +%s)"
    at="$(sed -nE 's/.*"syncedAt"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$RUNNER_STATE/status.json" 2>/dev/null | head -1 || true)"
    heard="$began"
    if [ -n "$at" ] && [ $((at / 1000)) -gt "$heard" ]; then heard=$((at / 1000)); fi
    if [ $((now - heard)) -ge "$silent" ]; then rc=125
    elif [ $((now - began)) -ge "$bound" ]; then rc=124
    fi
    if [ "$rc" != 0 ]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return "$rc"
    fi
    sleep 1
  done
  wait "$pid" || rc=$?
  return "$rc"
}

# The exit of a leave refused for the classes on the machine, apart from
# every other refusal's 1: scripts/vast-runner.sh (runners-down) reads it as
# "ask again with --force", its operator having said already that the
# machines go.
LEAVE_HOLDS_CLASSES=3

runner_leave() {
  need_root
  local join img drain bound silent rc=0 force=0 arg classes
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      *) die "usage: colloq-host runner leave [--force]" ;;
    esac
  done
  if ! docker container inspect "$RUNNER_NAME" >/dev/null 2>&1; then
    say "there is no $RUNNER_NAME on this machine: nothing to leave"
    return 0
  fi
  adopt_runner strict
  # Classes here move off this machine on a leave, at once and without
  # their variables (remote-classes.md §11.5): each comes back at its next
  # run, on the home's server or another machine. Asked first, before anything
  # of the agent's is changed, and --force says yes. Asked of the agent's
  # own tree, which a machine joined with a plain docker run names only once
  # it is taken over (adopt_runner: the classes are counted by its label).
  classes="$(class_count)"
  if [ "$classes" != 0 ] && [ "$force" = 0 ]; then
    printf '[colloq-host] ERROR: %s\n' "this machine holds $classes class(es) of its home: leaving moves them off it, and their variables are lost (colloq-host runner leave --force leaves all the same)" >&2
    exit "$LEAVE_HOLDS_CLASSES"
  fi
  [ "$classes" = 0 ] || say "--force: the $classes class(es) on this machine move off it as it leaves, and their variables are lost"
  join="$(env_value COLLOQ_RUNNER_JOIN)"
  # Gone for good once it has revoked itself: the agent stops when the home
  # answers 401, and Docker's unless-stopped would start it again, into a
  # machine its home no longer knows.
  docker update --restart=no "$RUNNER_NAME" >/dev/null
  if [ "$(docker container inspect -f '{{.State.Running}}' "$RUNNER_NAME" 2>/dev/null || true)" = true ]; then
    # The runs it holds may take the drain's bound, the revoke after them a
    # few minutes more; the home's silence ends the wait long before either
    # (leave_running_agent). Ten minutes of it, as long as the one-off below
    # tries (runner-agent/main.ts · ONE_OFF_LEAVE_MS).
    drain="$(setting COLLOQ_RUNNER_DRAIN_SEC 15720)"
    case "$drain" in ''|*[!0-9]*) die "COLLOQ_RUNNER_DRAIN_SEC=$drain is not a number of seconds" ;; esac
    bound="$(setting COLLOQ_RUNNER_LEAVE_SEC $((drain + 600)))"
    silent="$(setting COLLOQ_RUNNER_LEAVE_SILENT_SEC 600)"
    case "$bound:$silent" in *[!0-9:]*) die "COLLOQ_RUNNER_LEAVE_SEC=$bound and COLLOQ_RUNNER_LEAVE_SILENT_SEC=$silent are numbers of seconds" ;; esac
    say "$RUNNER_NAME leaves its home: it finishes the runs it holds, takes no new ones, then revokes itself"
    leave_running_agent "$bound" "$silent" || rc=$?
    if [ "$rc" != 0 ]; then
      docker update --restart=unless-stopped "$RUNNER_NAME" >/dev/null 2>&1 || true
      case "$rc" in
        125) die "$RUNNER_NAME has heard nothing from its home ($(runner_home)) for $(span "$silent") while leaving, and a leave ends with the home's answer. It keeps running and leaving: it takes no new work, and revokes itself as soon as the home answers. If the home is gone for good, revoke the machine there if you can, and remove it here (docker rm -f $RUNNER_NAME) or destroy it" ;;
        124) die "$RUNNER_NAME has not left in $(span "$bound"): it still finishes its runs, or waits for its home (its words are above). It keeps running and leaving, taking no new work; retry later, or revoke it on the home (Resources → Machines)" ;;
        *) die "$RUNNER_NAME did not leave (its words are above) and keeps running; retry, or revoke it on the home (Resources → Machines)" ;;
      esac
    fi
  else
    img="$(docker container inspect -f '{{.Config.Image}}' "$RUNNER_NAME")"
    say "$RUNNER_NAME is stopped: it revokes itself from a one-off container of $img"
    # What the agent's own container sees (runner_mounts: the CA bundle above
    # all, without which Node trusts nothing the settings name), and its two
    # words about itself: COLLOQ_RUNNER_IMAGE, the image it probes with, as
    # its own container has it; COLLOQ_RUNNER_CONTAINER empty, since this
    # one-off is not the machine's container, and an agent with none of its
    # own docker-updates nothing by a name (§13c note 20). The machine's own
    # restart policy was turned off above. On the host's network, as the
    # agent was (run_runner): its way to the home is the host's.
    runner_mounts
    docker run --rm --network host "${RUNNER_MOUNTS[@]}" \
      --env-file "$ENV_FILE" -e "COLLOQ_RUNNER_STATE=$RUNNER_STATE" \
      -e "COLLOQ_RUNNER_IMAGE=$img" -e COLLOQ_RUNNER_CONTAINER= \
      "$img" runner leave \
      || die "$RUNNER_NAME did not leave (its words are above) and stays stopped; revoke it on the home (Resources → Machines), or start it and retry"
  fi
  docker rm -f "$RUNNER_NAME" >/dev/null 2>&1 || true
  retire_identity
  if [ -n "$join" ]; then
    ensure_conf
    printf '%s\n' "$(join_digest "$join")" >> "$RUNNER_LEFT_FILE"
    chmod 0600 "$RUNNER_LEFT_FILE"
    unset_env_value COLLOQ_RUNNER_JOIN
  fi
  # A machine that joins again follows its new home's version, not this one's.
  rm -f "$RUNNER_IMAGE_FILE"
  say "left: the home no longer counts on this machine. Its cache stays in $RUNNER_STATE (remove it to free the disk)"
  say "to join again: colloq-host runner up https://<home> <a new code>"
}

# ------------------------------------------- codes for machines (on a home)
#
# The owner's enrollment code minted on the instance itself, for when the
# panel is out of reach (Teleport's SSH is the way in to a university's VM,
# not its browser): the same row the panel writes, by the same code
# (dist/runner-code.js through the entry point, as the server's user). Printed
# once, inside the three commands a machine joins with.

runner_code_usage() {
  cat <<'USAGE'
colloq-host runner-code: a code that lets machines run this instance's submissions

  colloq-host runner-code [--machines N] [--hours H] [--trusted | --classes] [--slots S] [--prefix NAME] [--url URL]

  --machines N   how many machines may join with it (1 to 100; 1)
  --hours H      how long it stays valid (1 to 24; 24)
  --trusted      the machines may receive the hidden test (off: a sealed competition waits for a trusted one)
  --classes      the machines take classes too: they see the students' code, files and personal
                 notebooks, and are never given the hidden test (so not with --trusted)
  --slots S      at most S places on each machine (default: what each machine offers)
  --prefix NAME  how the machines are named on the home
  --url URL      the address machines reach this instance at (default: PUBLIC_URL)
USAGE
}

in_range() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

expiry_text() {
  local s=$(( $1 / 1000 ))
  date -u -d "@$s" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || date -u -r "$s" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || printf '%s ms' "$1"
}

runner_code() {
  need_root
  local machines=1 hours=24 trusted=0 classes=0 slots="" prefix="" url="" out line code expires granted trust takes what up_flag img shown version suffix
  local args=() prefix_re='^[A-Za-z0-9][A-Za-z0-9-]{0,31}$' official_re='^ghcr\.io/colloq-edu/colloq-(vast|server)(:[^/@]+|@sha256:[a-f0-9]{64})$'
  local release_re='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' published_re='^ghcr\.io/colloq-edu/colloq-server:[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'
  local local_only_re='^((sha256:)?[a-f0-9]{12,64}|colloq-previous:[^/@]+)$'
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --machines|--hours|--slots|--prefix|--url)
        [ "$#" -ge 2 ] || die "$1 needs a value (colloq-host runner-code --help)"
        case "$1" in
          --machines) machines="$2" ;;
          --hours) hours="$2" ;;
          --slots) slots="$2" ;;
          --prefix) prefix="$2" ;;
          --url) url="$2" ;;
        esac
        shift 2 ;;
      --trusted) trusted=1; shift ;;
      --classes) classes=1; shift ;;
      -h|--help) runner_code_usage; return 0 ;;
      *) die "unknown option $1 (colloq-host runner-code --help)" ;;
    esac
  done
  # No hidden test beside classes (remote-classes.md D3): the minter refuses the pair too.
  [ "$trusted" = 0 ] || [ "$classes" = 0 ] \
    || die "--classes and --trusted do not go together: a machine that takes classes is never given the hidden test"
  in_range "$machines" 1 100 || die "--machines is how many machines may join with the code: 1 to 100"
  in_range "$hours" 1 24 || die "--hours is how long the code stays valid: 1 to 24 (a code is a door, and a door left open is found)"
  [ -z "$slots" ] || in_range "$slots" 1 64 || die "--slots caps the places on each machine: 1 to 64"
  [ -z "$prefix" ] || [[ "$prefix" =~ $prefix_re ]] || die "--prefix is a short name: letters, digits and hyphens, up to 32"
  [ -n "$url" ] || url="$(grep -E '^PUBLIC_URL=' "$STATE/.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '\r' || true)"
  [ -n "$url" ] || die "this instance has no address yet (PUBLIC_URL in $STATE/.env); name the one machines reach: --url https://<address>"
  url="${url%/}"
  check_home "$url"
  case "${url#*://}" in
    localhost|localhost:*|127.*)
      warn "$url is this machine's own loopback: a machine anywhere else cannot reach it; give the address it can: --url https://<address>" ;;
  esac
  [ "$(docker container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || true)" = true ] \
    || die "$NAME is not running here: the code is minted by the instance itself (colloq-host start)"
  args=(--machines "$machines" --hours "$hours")
  [ "$trusted" = 0 ] || args+=(--trusted)
  [ "$classes" = 0 ] || args+=(--classes)
  [ -z "$slots" ] || args+=(--slots "$slots")
  [ -z "$prefix" ] || args+=(--prefix "$prefix")
  out="$(docker exec "$NAME" colloq-vast runner-code "${args[@]}")" || die "$NAME did not mint a code (its words are above)"
  line="$(printf '%s\n' "$out" | grep -E '^[[:space:]]*\{' | tail -1 || true)"
  code="$(printf '%s' "$line" | sed -nE 's/.*"code"[[:space:]]*:[[:space:]]*"([a-f0-9]{32})".*/\1/p')"
  expires="$(printf '%s' "$line" | sed -nE 's/.*"expiresAt"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p')"
  granted="$(printf '%s' "$line" | sed -nE 's/.*"machines"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p')"
  trust="$(printf '%s' "$line" | sed -nE 's/.*"trusted"[[:space:]]*:[[:space:]]*(true|false).*/\1/p')"
  takes="$(printf '%s' "$line" | sed -nE 's/.*"classes"[[:space:]]*:[[:space:]]*(true|false).*/\1/p')"
  [ -n "$code" ] && [ -n "$expires" ] \
    || die "$NAME answered without a code this script can read; mint one in the panel (Resources → Machines → Connect a machine)"
  # The machines run the very build the instance runs: its own image, under
  # the name that says what it is off Vast when it is the published one (one
  # digest, two names), and by the release it was built as, not a moving tag.
  img="$(docker container inspect -f '{{.Config.Image}}' "$NAME")"
  shown="$img"
  if [[ "$img" =~ $official_re ]]; then
    version="$(image_label "$img" org.opencontainers.image.version)"
    if [[ "$version" =~ $release_re ]]; then
      shown="ghcr.io/colloq-edu/colloq-server:$version"
    else
      # No release label to go by: the same tag or digest under the other name.
      suffix="${img#ghcr.io/colloq-edu/colloq-vast}"
      [ "$suffix" != "$img" ] || suffix="${img#ghcr.io/colloq-edu/colloq-server}"
      shown="ghcr.io/colloq-edu/colloq-server$suffix"
    fi
  elif [[ "$img" =~ $local_only_re ]]; then
    # An image only this host holds: its id (update sha256:…), or the tag
    # rollback_ref keeps one with no name and no digest by. No other machine
    # can pull it, so they run the published image of the release it was
    # built as, as the panel names it (commands.ts · runnerImage, LOCAL_ONLY).
    version="$(image_label "$img" org.opencontainers.image.version)"
    if [[ "$version" =~ $release_re ]]; then
      shown="ghcr.io/colloq-edu/colloq-server:$version"
    fi
  fi
  if [ "$takes" = true ]; then what='; takes classes, and is never given the hidden test'
  elif [ "$trust" = true ]; then what='; trusted with the hidden test'
  else what='; not given the hidden test'
  fi
  say "a code for ${granted:-$machines} machine(s), valid until $(expiry_text "$expires")$what${slots:+; at most $slots places each}"
  if [ "$takes" = true ]; then
    say "it is shown once, below; it lets those machines take this instance's submissions and its classes, whose code, files and personal notebooks they see: send it to whoever sets them up, never to a class chat"
  else
    say "it is shown once, below; it lets those machines take this instance's submissions: send it to whoever sets them up, never to a class chat"
  fi
  # A machine for classes checks first, on a bare machine, that it can host them (runner_up · classes_problems).
  up_flag=""
  [ "$takes" != true ] || up_flag=" --classes"
  printf '\nDocker already installed (Linux amd64, Docker Engine 28+; GPU hosts also need nvidia-container-toolkit):\n\n'
  # --stop-timeout 90, as run_runner gives it: an image cannot set its own,
  # and with Docker's 10 s a stop or a reboot killed the agent before it had
  # handed its runs back, so they counted as losses after the container
  # started. --network host, as run_runner gives it too (D19): class kernels
  # publish Jupyter on the host's loopback, where only an agent on the
  # host's network reaches it. The panel's copy
  # (competitions/remote/commands.ts) is this one, byte for byte
  # (tests/remote-runner-commands.test.mts).
  printf '  docker run -d --name colloq-runner --restart unless-stopped --network host --stop-timeout 90 \\\n'
  printf '    -v /var/run/docker.sock:/var/run/docker.sock \\\n'
  printf '    -v /var/lib/colloq-runner:/var/lib/colloq-runner \\\n'
  printf "    -e COLLOQ_RUNNER_JOIN='%s#%s' \\\\\n" "$url" "$code"
  printf '    %s runner\n' "$shown"
  printf '\nA bare machine (adds the NVIDIA toolkit, checks for driver 580+, freezes updates on Vast):\n\n'
  printf '  command -v docker || curl -fsSL https://get.docker.com | sh\n'
  printf '  docker run --rm -v /usr/local/sbin:/host %s install-host /host\n' "$shown"
  if [[ "$shown" =~ $published_re ]]; then
    # The very image `runner up` takes by itself: this release, published.
    printf '  colloq-host runner up %s %s%s\n' "$url" "$code" "$up_flag"
    printf '\nVast VMs, from a checkout of the repository:\n\n'
    printf '  make vast-runner COUNT=%s CODE=%s URL=%s\n\n' "${granted:-$machines}" "$code" "$url"
  else
    printf '  colloq-host runner up %s %s %s%s\n\n' "$url" "$code" "$shown" "$up_flag"
    say "make vast-runner is left out: its machines take the published colloq-server of this release, and this instance runs $img"
  fi
}

# -------------------------------------------------------------- doctor
#
# One line per question, PASS / WARN / FAIL (and INFO for what is only worth
# knowing), and a non-zero exit on any FAIL. It reads and asks, and changes
# nothing: no container, no settings written, no installs. That is why it can
# run before the first `up`, and before a class on a live instance.
DOCTOR_FAILS=0
DOCTOR_WARNS=0
report() {
  local level="$1" label="$2"; shift 2
  case "$level" in
    FAIL) DOCTOR_FAILS=$((DOCTOR_FAILS + 1)) ;;
    WARN) DOCTOR_WARNS=$((DOCTOR_WARNS + 1)) ;;
  esac
  printf '%-4s  %-11s %s\n' "$level" "$label" "$*"
}

with_timeout() {
  local seconds="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$seconds" "$@"; else "$@"; fi
}

file_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || true; }
file_owner() { stat -c '%U' "$1" 2>/dev/null || stat -f '%Su' "$1" 2>/dev/null || true; }

# 0 resolves, 1 does not, 3 nothing here to ask with (getent's own 2 means
# "no such name", so it is not reused for that).
resolves() {
  if command -v getent >/dev/null 2>&1; then
    with_timeout 6 getent ahosts "$1" >/dev/null 2>&1 && return 0
  elif command -v host >/dev/null 2>&1; then
    with_timeout 6 host "$1" >/dev/null 2>&1 && return 0
  else
    return 3
  fi
  return 1
}

# Listening sockets on a port, as "address process".
listeners() {
  if command -v ss >/dev/null 2>&1; then
    ss -ltnp 2>/dev/null | awk -v p="$1" '$1 == "LISTEN" { n = split($4, a, ":"); if (a[n] == p) print $4, $6 }' || true
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltnp 2>/dev/null | awk -v p="$1" '$6 == "LISTEN" { n = split($4, a, ":"); if (a[n] == p) print $4, $7 }' || true
  else
    return 2
  fi
}

doctor() {
  local root=1 img img_present=0 docker_ok=0 sec="" v
  [ "$(id -u)" = 0 ] || root=0
  say "checking this machine for Colloq (nothing is changed)"
  [ "$root" = 1 ] || report WARN user "not root: $CONF_DIR and the firewall cannot be read; run it as root for the whole picture"
  offline && report INFO offline "COLLOQ_OFFLINE=1: no pulls, no apt, no get.docker.com; Docker must be installed already, images come from colloq-host load"
  img="$(configured_image)"

  # --- the machine
  local arch img_arch
  arch="$(uname -m 2>/dev/null || echo unknown)"
  case "$arch" in
    x86_64|amd64) report PASS arch "$arch" ;;
    *)
      img_arch=""
      [ -z "$img" ] || img_arch="$(docker image inspect -f '{{.Architecture}}' "$img" 2>/dev/null || true)"
      case "$arch:$img_arch" in
        aarch64:arm64|arm64:arm64) report PASS arch "$arch, and $img here is built for it" ;;
        *) report FAIL arch "$arch: the published images are linux/amd64 only; build one for this machine (make vast-image) and name it in $IMAGE_FILE" ;;
      esac ;;
  esac
  local kernel kmaj kmin
  kernel="$(uname -r 2>/dev/null || echo unknown)"
  IFS=. read -r kmaj kmin _ <<<"$kernel"
  if [[ "$kmaj" =~ ^[0-9]+$ ]] && [[ "${kmin%%[!0-9]*}" =~ ^[0-9]+$ ]] && { [ "$kmaj" -lt 5 ] || { [ "$kmaj" -eq 5 ] && [ "${kmin%%[!0-9]*}" -lt 4 ]; }; }; then
    report WARN kernel "Linux $kernel is older than 5.4; current Docker and cgroup v2 want a 5.x kernel or newer"
  else
    report PASS kernel "Linux $kernel"
  fi

  # --- Docker
  if ! command -v docker >/dev/null 2>&1; then
    if offline; then report FAIL docker "not installed, and an offline install never downloads it: install Docker Engine 28 or newer (docker-ce) from your distribution or an internal mirror"
    else report FAIL docker "not installed: colloq-host up installs it from get.docker.com, or install Docker Engine 28 or newer yourself first (better on a server you keep)"
    fi
  elif ! v="$(docker version --format '{{.Server.Version}}' 2>/dev/null)" || [ -z "$v" ]; then
    report FAIL docker "the daemon does not answer: systemctl start docker (and check who may use its socket)"
  else
    docker_ok=1
    local major="${v%%.*}"
    if ! [[ "$major" =~ ^[0-9]+$ ]]; then report WARN docker "Docker $v: an unfamiliar version string"
    elif [ "$major" -ge 28 ]; then report PASS docker "Docker $v"
    elif [ "$major" -ge 20 ]; then report WARN docker "Docker $v: Colloq is tested with Docker 28 and newer; upgrade docker-ce before the first class"
    else report FAIL docker "Docker $v is too old: install Docker Engine 28 or newer"
    fi
    sec="$(docker info --format '{{join .SecurityOptions " "}}' 2>/dev/null || true)"
    case "$sec" in *rootless*) report FAIL docker "rootless Docker: the rooms' firewall helper needs a rootful daemon (a privileged container in the host's namespaces)" ;; esac
  fi
  local cg=""
  [ "$docker_ok" = 0 ] || cg="$(docker info --format '{{.CgroupVersion}}' 2>/dev/null || true)"
  if [ -z "$cg" ]; then
    if [ -f /sys/fs/cgroup/cgroup.controllers ]; then cg=2; elif [ -d /sys/fs/cgroup ]; then cg=1; fi
  fi
  case "$cg" in
    2) report PASS cgroup "v2" ;;
    1) report WARN cgroup "v1: Docker still limits every room, but v1 is on its way out of Docker and the distributions; boot with systemd.unified_cgroup_hierarchy=1" ;;
    *) report WARN cgroup "cannot tell the cgroup version (no /sys/fs/cgroup)" ;;
  esac
  if [ "$docker_ok" = 1 ]; then
    # Rooms get their network block from iptables rules hooked into
    # DOCKER-USER (server/src/kernel/perimeter.ts), and refuse to start
    # without it; Docker's nftables backend has no such chain.
    local fw room_net
    fw="$(docker info --format '{{with .FirewallBackend}}{{.Driver}}{{end}}' 2>/dev/null || true)"
    room_net="$(setting COLLOQ_ROOM_NETWORK)"
    case "$fw" in
      *nftables*)
        if [ "$room_net" = open ]; then report WARN firewall "Docker uses its nftables backend: no DOCKER-USER chain, so rooms run unfenced (COLLOQ_ROOM_NETWORK=open)"
        else report FAIL firewall "Docker uses its nftables backend, which has no DOCKER-USER chain; rooms refuse to start without their firewall. Run dockerd with the iptables backend (the default)"
        fi ;;
      *)
        if [ "$root" = 1 ] && command -v iptables >/dev/null 2>&1; then
          if iptables -w -n -L DOCKER-USER >/dev/null 2>&1; then report PASS firewall "${fw:-iptables} backend, DOCKER-USER present"
          elif [ "$room_net" = open ]; then report WARN firewall "no DOCKER-USER chain (Docker does not manage iptables here): rooms run unfenced (COLLOQ_ROOM_NETWORK=open)"
          else report FAIL firewall "no DOCKER-USER chain: Docker does not manage iptables here (\"iptables\": false in daemon.json?), and rooms refuse to start without their firewall"
          fi
        elif [ -n "$fw" ]; then report PASS firewall "$fw backend (as Docker reports it)"
        else report WARN firewall "cannot check the firewall backend (needs root and iptables)"
        fi ;;
    esac
    if command -v systemctl >/dev/null 2>&1; then
      case "$(systemctl is-enabled docker 2>/dev/null || true)" in
        enabled|static|alias|indirect|generated) ;;
        *) report WARN boot "Docker does not start at boot, and Colloq comes back only with it: systemctl enable docker (colloq-host up does this)" ;;
      esac
    fi
  fi

  # --- size
  local cpus mem_kb mem_gb
  cpus="$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 0)"
  mem_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null || true)"
  if [ -z "$mem_kb" ]; then
    report WARN resources "$cpus vCPU; cannot read /proc/meminfo for the memory size"
  else
    mem_gb="$(awk -v k="$mem_kb" 'BEGIN { printf "%.1f", k / 1048576 }')"
    # 7.5 GiB, not 8: MemTotal leaves out what the kernel reserves, and a
    # machine sold as 8 GB shows about 7.7 of them.
    if [ "$cpus" -lt 4 ] || [ "$mem_kb" -lt 7864320 ]; then
      report WARN resources "$cpus vCPU, $mem_gb GB RAM: under the floor of 4 vCPU and 8 GB (one class in one shared room)"
    else
      report PASS resources "$cpus vCPU, $mem_gb GB RAM"
    fi
  fi
  report INFO sizing "a server to start with: 16 vCPU, 64 GB RAM, 250 GB NVMe, x86-64, no GPU (30 students with personal notebooks, or a class and a competition); docs/pages/en/server.html"
  local probe line free_kb mount
  probe="$STATE"
  while [ ! -d "$probe" ] && [ "$probe" != / ]; do probe="$(dirname "$probe")"; done
  line="$(df -Pk "$probe" 2>/dev/null | awk 'NR == 2 { print $4, $6 }' || true)"
  free_kb="${line%% *}"; mount="${line#* }"
  if ! [[ "$free_kb" =~ ^[0-9]+$ ]]; then
    report WARN disk "df did not answer for $probe"
  elif [ $((free_kb / 1048576)) -lt 60 ]; then
    report WARN disk "$((free_kb / 1048576)) GB free on $mount, where the state lives ($STATE): keep at least 60 GB for backups, room files and competition data"
  else
    report PASS disk "$((free_kb / 1048576)) GB free on $mount ($STATE)"
  fi
  if [ "$docker_ok" = 1 ]; then
    local droot dline dfree dmount
    droot="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
    if [ -n "$droot" ] && [ -d "$droot" ]; then
      dline="$(df -Pk "$droot" 2>/dev/null | awk 'NR == 2 { print $4, $6 }' || true)"
      dfree="${dline%% *}"; dmount="${dline#* }"
      if [[ "$dfree" =~ ^[0-9]+$ ]] && [ "$dmount" != "$mount" ]; then
        if [ $((dfree / 1048576)) -lt 30 ]; then report WARN disk "$((dfree / 1048576)) GB free on $dmount, where Docker keeps the images ($droot): a kernel image is 1 to 9 GB"
        else report PASS disk "$((dfree / 1048576)) GB free on $dmount for Docker's images ($droot)"
        fi
      fi
    fi
  fi

  # --- where it listens
  local bind port_l found
  bind="$(bind_addr)"
  if [ "$docker_ok" = 1 ] && [ "$(docker container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || true)" = true ]; then
    report PASS port "$bind:$LISTEN_PORT is our running container $NAME"
  elif found="$(listeners "$LISTEN_PORT")"; then
    if [ -n "$found" ]; then
      report FAIL port "$bind:$LISTEN_PORT is taken: $(printf '%s' "$found" | head -1); stop that, or choose another port (PORT=… colloq-host up)"
    else
      report PASS port "$bind:$LISTEN_PORT is free"
    fi
  else
    report WARN port "cannot see who listens on $LISTEN_PORT (no ss or netstat)"
  fi
  # A bind address this machine does not have makes `docker run -p` fail at up.
  if [[ "$bind" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ "$bind" != 0.0.0.0 ] && ! is_loopback "$bind" \
      && command -v ip >/dev/null 2>&1 && ! ip -o addr show 2>/dev/null | grep -q " inet $bind/"; then
    report FAIL port "COLLOQ_BIND=$bind is not an address of this machine (ip addr): Docker cannot publish the port there"
  fi

  # --- names, time, the registry
  local url host code hp dp
  url="$(setting PUBLIC_URL)"
  host="${url#*://}"; host="${host%%/*}"; host="${host%:*}"
  local rc
  if [ -n "$url" ] && [ "$host" != localhost ] && ! [[ "$host" =~ ^[0-9.]+$ ]] && ! [[ "$host" =~ : ]]; then
    rc=0; resolves "$host" || rc=$?
    case "$rc" in
      0) report PASS dns "$host resolves" ;;
      3) report WARN dns "cannot check name resolution (no getent or host)" ;;
      *) report WARN dns "$host does not resolve from this server (students' machines must resolve it; this one only if you test from here)" ;;
    esac
  fi
  if ! offline; then
    rc=0; resolves ghcr.io || rc=$?
    case "$rc" in
      0) report PASS dns "ghcr.io resolves" ;;
      3) [ -n "$url" ] || report WARN dns "cannot check name resolution (no getent or host)" ;;
      *) report WARN dns "ghcr.io does not resolve: pulls will fail; fix DNS, or install offline with colloq-host bundle and load" ;;
    esac
  fi
  if command -v timedatectl >/dev/null 2>&1; then
    v="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    [ -n "$v" ] || v="$(timedatectl status 2>/dev/null | sed -n 's/.*synchronized: *//p' | head -1 || true)"
    case "$v" in
      yes) report PASS clock "synchronized" ;;
      *) report WARN clock "not synchronized: sign-in links, cookies and certificates depend on the clock; enable systemd-timesyncd or chrony (an internal NTP server on an offline campus)" ;;
    esac
  else
    report WARN clock "cannot check (no timedatectl); make sure NTP runs"
  fi
  hp="$(setting HTTPS_PROXY)"; [ -n "$hp" ] || hp="$(setting https_proxy)"
  if offline; then
    report INFO registry "not asked: COLLOQ_OFFLINE=1"
  else
    code="$(HTTPS_PROXY="$hp" https_proxy="$hp" NO_PROXY="$(setting NO_PROXY)" \
      curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 https://ghcr.io/v2/ 2>/dev/null || true)"
    [ "$docker_ok" = 0 ] || [ -z "$img" ] || ! docker image inspect "$img" >/dev/null 2>&1 || img_present=1
    case "$code" in
      200|401|403|404|405) report PASS registry "ghcr.io answers (HTTP $code)" ;;
      *)
        if [ "$img_present" = 1 ]; then report WARN registry "ghcr.io is out of reach (outbound HTTPS, a proxy?): updates will need it, or colloq-host bundle and load"
        else report FAIL registry "ghcr.io is out of reach (outbound HTTPS, a proxy?), and the image is not here: fix the way out, or install offline with colloq-host bundle and load"
        fi ;;
    esac
  fi
  if [ -n "$hp" ] && [ "$docker_ok" = 1 ]; then
    dp="$(docker info --format '{{.HTTPSProxy}}' 2>/dev/null || true)"
    [ -n "$dp" ] || report WARN proxy "HTTPS_PROXY is set for Colloq, but the Docker daemon has no proxy, and pulls are the daemon's: give dockerd the proxy too (a systemd drop-in for docker.service)"
    [ -n "$(setting NO_PROXY)$(setting no_proxy)" ] || report WARN proxy "HTTPS_PROXY without NO_PROXY: list localhost,127.0.0.1 and your internal hosts in NO_PROXY"
  fi

  # --- the address and the proxy in front
  local mode relay named tp
  mode="$(setting COLLOQ_TUNNEL auto)"
  relay=0; named=0
  [ -z "$(setting COLLOQ_HOSTNAME)" ] || [ -z "$(setting RELAY_ADDR)" ] || [ -z "$(setting RELAY_TOKEN)" ] || [ -z "$(setting RELAY_DOMAIN)" ] || relay=1
  [ -z "$(setting COLLOQ_HOSTNAME)" ] || [ -z "$(setting CLOUDFLARE_TUNNEL_TOKEN)" ] || named=1
  case "$url" in
    '')
      if [ "$relay" = 1 ] && { [ "$mode" = auto ] || [ "$mode" = relay ]; }; then report PASS public-url "given by the relay tunnel"
      elif [ "$named" = 1 ] && { [ "$mode" = auto ] || [ "$mode" = cloudflare ]; }; then report PASS public-url "given by the named Cloudflare tunnel"
      elif [ "$mode" = cloudflare ] || { [ "$mode" = auto ] && on_vast; }; then report INFO public-url "a quick *.trycloudflare.com address, printed in the log"
      else report WARN public-url "not set: every link Colloq hands out will say http://localhost:$LISTEN_PORT; set PUBLIC_URL=https://<the address students open>"
      fi ;;
    https://*) report PASS public-url "$url" ;;
    http://localhost*|http://127.*|'http://[::1]'*) report INFO public-url "$url: plain http on this machine only" ;;
    http://*) report WARN public-url "$url is plain http: sign-in cookies are not Secure and HSTS is off; put an HTTPS proxy in front and give its https:// address" ;;
    *) report FAIL public-url "$url: it must start with https:// (or http://)" ;;
  esac
  case "${url#*://}" in */?*) report WARN public-url "Colloq sits at the root of a hostname; a path in PUBLIC_URL ($url) is not supported" ;; esac
  tp="$(setting TRUSTED_PROXIES)"
  if [ -n "$tp" ]; then
    report PASS proxies "TRUSTED_PROXIES=$tp"
  elif is_loopback "$bind"; then
    report PASS proxies "loopback bind: a proxy on this machine is trusted by itself (loopback and Docker's gateway)"
  else
    report WARN proxies "Colloq listens on $bind: set TRUSTED_PROXIES=<your proxy's address>, or every student looks like the proxy and shares its per-address limits (SHARED_ADDRESSES for a campus NAT)"
  fi
  if [ "$bind" = 0.0.0.0 ] || [ "$bind" = '::' ]; then
    report INFO port "published on every interface: let only the proxy reach $LISTEN_PORT (a firewall), or bind to the address it uses (COLLOQ_BIND=<ip>)"
  fi

  # --- settings on disk
  if [ ! -d "$CONF_DIR" ]; then
    report INFO config "$CONF_DIR does not exist yet (colloq-host up writes it)"
  elif [ "$root" = 1 ]; then
    local dmode fmode owner problems=""
    dmode="$(file_mode "$CONF_DIR")"; owner="$(file_owner "$CONF_DIR")"
    case "$dmode" in *00) ;; *) problems="$problems $CONF_DIR is $dmode (chmod 700);" ;; esac
    [ "$owner" = root ] || problems="$problems $CONF_DIR belongs to $owner;"
    if [ -f "$ENV_FILE" ]; then
      fmode="$(file_mode "$ENV_FILE")"
      case "$fmode" in *00) ;; *) problems="$problems colloq.env is $fmode and holds secrets (chmod 600);" ;; esac
      [ "$(file_owner "$ENV_FILE")" = root ] || problems="$problems colloq.env does not belong to root;"
    fi
    if [ -n "$problems" ]; then report WARN config "${problems# }"
    else report PASS config "$CONF_DIR 0${dmode#0}, colloq.env private to root"
    fi
  fi

  # --- mandatory access control
  if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce 2>/dev/null || true)" = Enforcing ]; then
    case "$sec" in
      *selinux*) report WARN selinux "enforcing, and Docker labels containers: the state directory is mounted without :z, so label it once (chcon -Rt container_file_t $STATE) or rooms cannot read their own files" ;;
      *) report INFO selinux "enforcing; Docker does not label containers here (selinux-enabled is off), so the mounts work as they are" ;;
    esac
  fi
  case "$sec" in *apparmor*) report INFO apparmor "rooms run under Docker's default AppArmor profile; the short-lived firewall helper is privileged and so unconfined" ;; esac

  # --- images
  if [ -z "$img" ]; then
    report WARN image "no image named yet: COLLOQ_IMAGE=ghcr.io/colloq-edu/colloq-vast:<version> colloq-host up, or colloq-host load <bundle>"
  elif [ "$docker_ok" = 0 ]; then
    report WARN image "$img: cannot look without Docker"
  elif docker image inspect "$img" >/dev/null 2>&1; then
    report PASS image "$img is here (version $(image_label "$img" org.opencontainers.image.version))"
  elif offline; then
    report FAIL image "$img is not on this machine, and COLLOQ_OFFLINE=1: colloq-host load <bundle>"
  else
    report INFO image "$img is not pulled yet (up pulls it)"
  fi
  if [ "$docker_ok" = 1 ]; then
    local wanted envname
    wanted="$(setting KERNEL_PRELOAD)"; [ -n "$wanted" ] || wanted="$(setting KERNEL_ENV base)"
    for envname in $(printf '%s' "$wanted" | tr ',' ' '); do
      if docker image inspect "colloq-kernel:$envname" >/dev/null 2>&1; then report PASS kernels "colloq-kernel:$envname is here"
      elif offline; then report FAIL kernels "colloq-kernel:$envname is not here, and offline it can be neither pulled nor built: colloq-host load <bundle>"
      else report INFO kernels "colloq-kernel:$envname is not here yet: the first start pulls the published one or builds it (minutes)"
      fi
    done
    if command -v nvidia-smi >/dev/null 2>&1; then
      local cards
      if ! cards="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>&1 | paste -sd, -)" || ! nvidia-smi -L >/dev/null 2>&1; then
        report WARN gpu "nvidia-smi fails (${cards%%,*}): GPU rooms get no card; after a driver update that is usually a reboot"
      elif docker info 2>/dev/null | grep -qi nvidia; then report INFO gpu "${cards:-an NVIDIA GPU}; nvidia-container-toolkit present"
      else report WARN gpu "an NVIDIA GPU without nvidia-container-toolkit: GPU rooms get no card (colloq-host up installs it when online)"
      fi
    fi
    if docker container inspect "$NAME" >/dev/null 2>&1; then
      report INFO container "$NAME: $(docker container inspect -f '{{.State.Status}}, image {{.Config.Image}}' "$NAME" 2>/dev/null || true)"
    fi
  fi

  if [ "$DOCTOR_FAILS" -gt 0 ]; then
    say "$DOCTOR_FAILS FAIL, $DOCTOR_WARNS WARN: fix the FAIL lines before the first class"
    return 1
  fi
  say "no FAIL, $DOCTOR_WARNS WARN"
}

usage() {
  cat <<'USAGE'
colloq-host: run Colloq (the colloq-vast / colloq-server image) on this machine's Docker

  colloq-host doctor                 check this machine: PASS / WARN / FAIL, before the first up too
  colloq-host up                     install what is missing, pull the image, start
  colloq-host update [IMAGE]         switch to another image, backup first; data and room kernels stay
  colloq-host status                 is the instance ready for a class
  colloq-host link                   the class address and the owner link
  colloq-host logs                   follow the log (Ctrl+C to leave)
  colloq-host backup                 a backup into <state>/backups/
  colloq-host backup-timer on|off|status   a backup every day at COLLOQ_BACKUP_AT (03:30)
  colloq-host restore [--image IMAGE] [FILES]   stop, restore a backup, start again
  colloq-host stop | start           stop / start Colloq (room kernels keep running)
  colloq-host bundle FILE [IMAGE]    on a connected machine: images for an offline server, in one file
  colloq-host load FILE              on the offline server: load that file; up then needs no network

  colloq-host runner up URL CODE [IMAGE] [--classes]   this machine runs another instance's submissions
  colloq-host runner update [VERSION|IMAGE] [--now] | status | logs | leave [--force]   (colloq-host runner help)
  colloq-host runner-code [--machines N] [--hours H] [--trusted | --classes] [--slots S]
                                     on an instance: a code for such machines, inside the commands that join them

Settings: /etc/colloq/colloq.env (written by `up` from its environment); the image: /etc/colloq/image.
A server of your own: docs/pages/en/server.html. A Vast VM: deploy/vast/README.md.
USAGE
}

cmd="${1:-help}"; [ "$#" -eq 0 ] || shift
case "$cmd" in
  doctor) doctor ;;
  up) up ;;
  update) update "$@" ;;
  status) need_root; docker exec "$NAME" colloq-vast status ;;
  link) need_root; docker exec "$NAME" colloq-vast link ;;
  logs) need_root; exec docker logs -f --tail 200 "$NAME" ;;
  backup) need_root; backup_now ;;
  backup-timer) backup_timer "$@" ;;
  restore) restore "$@" ;;
  stop) need_root; docker stop -t 30 "$NAME" ;;
  start) need_root; docker start "$NAME" >/dev/null && wait_ready ;;
  bundle) bundle "$@" ;;
  load) load "$@" ;;
  runner) runner_command "$@" ;;
  runner-code) runner_code "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $cmd (colloq-host help)" ;;
esac
