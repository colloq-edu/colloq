.vite/

# Штамп «какой список пакетов запечён в образ ядра на ЭТОЙ машине». Состояние
# машины, а не исходник: на чужом клоне он говорил бы про образ, которого там
# нет.
kernel/environments/.*.built

# Локальный запуск через make run.
.colloq.pid
.colloq.log

# Состояние супервизора занятия (make dev, colloq start): расписка идущей
# сессии, штампы сборки и образа ядра. Машинное, не исходник.
.colloq/
backups/
# cloudflared, скачанный colloq для --share и host (cli/src/launch-cloudflared.ts):
# в клоне каталог состояния — сам клон, и бинарь в сорок мегабайт ложится в bin/.
/bin/

# Журналы, забранные с арендованных машин: make vast-logs. Секреты из них
# вырезаны на лету, но это всё равно чужая пара — адреса комнат, числа, время.
# Место им рядом с копиями, а не в истории репозитория.
logs/

# Снимки, которые делает `make ui --shot`: смотрят их глазами и тут же
# выбрасывают. Их четыре — комната, проекция, пульт и общий кадр, — и в дереве
# они лежали неназванными ровно до первого прогона со снимками.
ui-check.png
ui-lecture.png
ui-projection.png
ui-pult.png
ui-pult-129.png
ui-pult-portrait.png
pencil-check-*.png

# Байт-код Python рядом со скриптами ретранслятора (scripts/relay-capy.py).
__pycache__/

# Isolated development worktrees.
.worktrees/

# Local agent plans and working notes; product documentation remains tracked.
/docs/superpowers/

# Черновые стенды агентов (scratchpad/*.mts) и настройки редактора: машинное
# и личное, а не исходник. В дереве они лежали неотслеженными, то есть ровно
# одним `git add .` от публичной истории.
/scratchpad/
/.vscode/

# Локальные скиллы Claude Code: инструмент конкретной машины, а не исходник
# продукта, и у сторонних скиллов своя лицензия.
/.claude/
